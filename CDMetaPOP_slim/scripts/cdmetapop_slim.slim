// Number of copies, among the haplosomes of focal_subpop, of mutations of mutType that arose in each patch (one value per patch,
// in sim.subpopulations order). Each substitution is carried by all 2N haplosomes.
function (integer) countByOrigin(object<Subpopulation>$ focal_subpop, object<MutationType>$ mutType){
	n_origins = length(sim.subpopulations);
	ids = focal_subpop.haplosomes.mutationsOfType(mutType).subpopID;
	sub_ids = sim.substitutionsOfType(mutType).subpopID;
	ids = ids[ids >= 0 & ids < n_origins];
	sub_ids = sub_ids[sub_ids >= 0 & sub_ids < n_origins];
	return tabulate(ids, n_origins - 1) + 2*focal_subpop.individualCount*tabulate(sub_ids, n_origins - 1);
}

// Additive contribution to the trait of the mutations of mutType that arose in each patch, for each individual in focal_subpop:
// a matrix with a row per individual and a column per origin patch (sim.subpopulations order). A mutation counts once per copy
// and a substitution twice (substitutions are homozygous in every individual). Calculated for all individuals and patches at once:
// (copies of each mutation in each individual) x (effect of each mutation, in the column of its origin patch).
function (float) additiveContributionsByOrigin(object<Subpopulation>$ focal_subpop, object<MutationType>$ mutType){
	inds = focal_subpop.individuals;
	n_inds = length(inds);
	n_origins = length(sim.subpopulations);
	contributions = matrix(float(n_inds*n_origins), nrow = n_inds);
	haps = inds.haplosomes;
	muts = haps.mutationsOfType(mutType);
	if(length(muts) > 0){
		unique_muts = unique(muts, preserveOrder = F);
		n_muts = length(unique_muts);
		// Individual (index in focal_subpop) carrying each copy
		// (counted per individual: haps.countOfMutationsOfType() on many haplosomes at once intermittently
		// crashes SLiM 5.1 or returns counts that don't match haps.mutationsOfType())
		owners = repEach(seqLen(n_inds), sapply(inds, "size(applyValue.haplosomes.mutationsOfType(mutType));"));
		copies = matrix(asFloat(tabulate(owners*n_muts + match(muts, unique_muts), n_inds*n_muts - 1)), nrow = n_muts);
		origins = unique_muts.subpopID;
		known = which(origins >= 0 & origins < n_origins);
		effects = float(n_muts*n_origins);
		effects[known + n_muts*origins[known]] = unique_muts.selectionCoeff[known];
		contributions = matrixMult(t(copies), matrix(effects, nrow = n_muts));
	}
	subs = sim.substitutionsOfType(mutType);
	sub_effects = sapply(sim.subpopulations.id, "sum(subs.selectionCoeff[subs.subpopID == applyValue]);");
	return contributions + matrix(repEach(2*sub_effects, n_inds), nrow = n_inds);
}

// Share of a focal patch's old variants (those present at MUTATION_ORIGIN_TICK) that came from
// each patch, using each variant's patch frequencies at MUTATION_ORIGIN_TICK. Counts copies of
// segregating mutations and of substitutions (carried by all 2N haplosomes). NA if there are no old variants.
function (*) originTickFreqs(object<Subpopulation>$ focal_subpop, object<Mutation> focal_mutations, object<Substitution> focal_subs){
	n_subpops = length(sim.subpopulations);
	counts = rep(0.0, n_subpops);
	if(length(focal_mutations) > 0){
		freqs800 = matrix(focal_mutations.getValue('freqs800'), nrow = n_subpops);
		current_counts = sim.mutationCounts(focal_subpop, focal_mutations);
		counts = counts + sapply(seqLen(n_subpops), "sum(current_counts*freqs800[applyValue,]);");
	}
	if(length(focal_subs) > 0){
		freqs800_subs = matrix(focal_subs.getValue('freqs800'), nrow = n_subpops);
		current_counts_subs = rep(focal_subpop.individualCount*2, length(focal_subs));
		counts = counts + sapply(seqLen(n_subpops), "sum(current_counts_subs*freqs800_subs[applyValue,]);");
	}
	if(sum(counts) == 0) return rep('NA', n_subpops);
	return counts/sum(counts);
}

function (string) mutationalOrigins(string header_string, integer focal_subpop_id){
	focal_subpop = sim.subpopulations[focal_subpop_id];
	// Any mutations in the focal patch? (mutationCounts() is much faster than collecting every copy of every mutation)
	if(focal_subpop.individualCount > 0 & sum(sim.mutationCounts(focal_subpop)) > 0){
		// Origin-tick frequencies only exist if mutation_origin_year was given; otherwise those columns are NA
		if(MUTATION_ORIGIN & community.tick > MUTATION_ORIGIN_TICK){
			all_mutations = unique(focal_subpop.haplosomes.mutationsOfType(m2));
			focal_mutations = all_mutations[all_mutations.originTick <= MUTATION_ORIGIN_TICK];
			new_mutations = all_mutations[all_mutations.originTick > MUTATION_ORIGIN_TICK];
			all_subs = sim.substitutionsOfType(m2);
			focal_subs = all_subs[all_subs.originTick <= MUTATION_ORIGIN_TICK];
			new_subs = all_subs[all_subs.originTick > MUTATION_ORIGIN_TICK];
			Topt_freq_origin_tick = originTickFreqs(focal_subpop, focal_mutations, focal_subs);
			Topt_prop_new = (length(new_mutations) + length(new_subs))/(length(all_mutations) + length(all_subs));
			
			all_mutations = unique(focal_subpop.haplosomes.mutationsOfType(m3));
			focal_mutations = all_mutations[all_mutations.originTick <= MUTATION_ORIGIN_TICK];
			new_mutations = all_mutations[all_mutations.originTick > MUTATION_ORIGIN_TICK];
			all_subs = sim.substitutionsOfType(m3);
			focal_subs = all_subs[all_subs.originTick <= MUTATION_ORIGIN_TICK];
			new_subs = all_subs[all_subs.originTick > MUTATION_ORIGIN_TICK];
			neutral_freq_origin_tick = originTickFreqs(focal_subpop, focal_mutations, focal_subs);
			neutral_prop_new = (length(new_mutations) + length(new_subs))/(length(all_mutations) + length(all_subs));
			
			all_mutations = unique(focal_subpop.haplosomes.mutationsOfType(m4));
			focal_mutations = all_mutations[all_mutations.originTick <= MUTATION_ORIGIN_TICK];
			new_mutations = all_mutations[all_mutations.originTick > MUTATION_ORIGIN_TICK];
			all_subs = sim.substitutionsOfType(m4);
			focal_subs = all_subs[all_subs.originTick <= MUTATION_ORIGIN_TICK];
			new_subs = all_subs[all_subs.originTick > MUTATION_ORIGIN_TICK];
			epsilon_freq_origin_tick = originTickFreqs(focal_subpop, focal_mutations, focal_subs);
			epsilon_prop_new = (length(new_mutations) + length(new_subs))/(length(all_mutations) + length(all_subs));
		}
		else{
			Topt_freq_origin_tick = rep('NA', length(sim.subpopulations));
			neutral_freq_origin_tick = rep('NA', length(sim.subpopulations));
			epsilon_freq_origin_tick = rep('NA', length(sim.subpopulations));
			Topt_prop_new = 'NA';
			neutral_prop_new = 'NA';
			epsilon_prop_new = 'NA';
		}
		Topt_prop_new = rep(Topt_prop_new, length(sim.subpopulations));
		neutral_prop_new = rep(neutral_prop_new, length(sim.subpopulations));
		epsilon_prop_new = rep(epsilon_prop_new, length(sim.subpopulations));


		origin_subpop = sim.subpopulations.id;
		// Counts are numbers of haplosomes: each substitution is carried by all 2N haplosomes in the focal patch
		Topt_count = countByOrigin(focal_subpop, m2);
		Topt_freq = Topt_count/sum(Topt_count);
		epsilon_count = countByOrigin(focal_subpop, m4);
		epsilon_freq = epsilon_count/sum(epsilon_count);
		neutral_count = countByOrigin(focal_subpop, m3);
		neutral_freq = neutral_count/sum(neutral_count);
		// Mean and variance among individuals in the focal patch of the additive contribution of mutations from each origin patch
		Topt_contributions = additiveContributionsByOrigin(focal_subpop, m2);
		epsilon_contributions = additiveContributionsByOrigin(focal_subpop, m4);
		Topt_mean_contribution = apply(Topt_contributions, 1, "mean(applyValue);");
		epsilon_mean_contribution = apply(epsilon_contributions, 1, "mean(applyValue);");
		Topt_VA = apply(Topt_contributions, 1, "var(applyValue);");
		epsilon_VA = apply(epsilon_contributions, 1, "var(applyValue);");
		origin_temp = GrowthTemperatureBack[origin_subpop];
		tick = rep(community.tick, length(origin_subpop));
		subpop = rep(focal_subpop.id, length(origin_subpop));
		subpop_temp = rep(GrowthTemperatureBack[focal_subpop.id], length(origin_subpop));
		lines = apply(executeLambda('matrix(c(' + header_string + '),nrow = length(origin_subpop));'), 0, "paste(applyValue, sep = ',');");
		add = paste(lines, sep = "\n");
	}
	else{
		add = 'NA';
	}
	return(add);
}

function (void) writeMutationalOrigins(string outfile, logical header, integer focal_subpop_ids){
	header_string = "tick,subpop,subpop_temp,origin_subpop,origin_temp,Topt_count,epsilon_count,neutral_count,Topt_mean_contribution,epsilon_mean_contribution,Topt_VA,epsilon_VA,Topt_freq,epsilon_freq,neutral_freq,Topt_freq_origin_tick,epsilon_freq_origin_tick,neutral_freq_origin_tick,Topt_prop_new,epsilon_prop_new,neutral_prop_new";
	if(header){
		writeFile(outfile, header_string);
		return;
	}
	lines = sapply(focal_subpop_ids, "mutationalOrigins(header_string, applyValue);");
	writeFile(outfile, lines, append = T);
	return;
}
function (void) writeMutationEffects(string outfile, logical header){
	header_string = "tick,substitution,phenotype,effect,frequency,count,id";
	if(header){
		writeFile(outfile, header_string);
		return;
	}
	topt_subs = unique(sim.substitutionsOfType(m2));
	topt_muts = unique(sim.subpopulations.individuals.haplosomes.mutationsOfType(m2));
	epsilon_subs = unique(sim.substitutionsOfType(m4));
	epsilon_muts = unique(sim.subpopulations.individuals.haplosomes.mutationsOfType(m4));
	if(length(topt_subs) > 0) writeFile(outfile, paste(sapply(topt_subs, "paste0(community.tick, ',', 'T', ',', 'Topt', ',', applyValue.selectionCoeff, ',', 1.0,',', 2*sum(sim.subpopulations.individualCount) ,',', applyValue.id);"), sep = '\n'), append = T);
	if(length(epsilon_subs) > 0) writeFile(outfile, paste(sapply(epsilon_subs, "paste0(community.tick, ',', 'T', ',', 'epsilon', ',', applyValue.selectionCoeff, ',', 1.0,',', 2*sum(sim.subpopulations.individualCount) ,',', applyValue.id);"), sep = '\n'), append = T);
	if(length(topt_muts) > 0) writeFile(outfile, paste(sapply(topt_muts, "paste0(community.tick, ',', 'F', ',', 'Topt', ',', applyValue.selectionCoeff, ',', sim.mutationFrequencies(NULL, applyValue),',', sim.mutationCounts(NULL, applyValue) ,',', applyValue.id);"), sep = '\n'), append = T);
	if(length(epsilon_muts) > 0) writeFile(outfile, paste(sapply(epsilon_muts, "paste0(community.tick, ',', 'F', ',', 'epsilon', ',', applyValue.selectionCoeff, ',', sim.mutationFrequencies(NULL, applyValue), ',', sim.mutationCounts(NULL, applyValue) ,',', applyValue.id);"), sep = '\n'), append = T);
	return;
}

function (void)writeClassOutput(string outfile, logical header){
	
	if(header){
		writeFile(outfile, "Year,Ages,N_Initial_Age,AgeSize_Mean,AgeSize_Std,Size_Classes,N_Initial_Class,ClassSize_Mean,ClassSize_Std,N_GrowthBack,N_BeforePacking_AddAge0s,PackingDeaths_Emigration,PackingDeaths_Immigration");
