function (void)updatePlotQTL(void)
{
	if (exists("slimgui"))
	{
		// Mutational effects
		min_effect = min(EFFECTS);
		max_effect = max(EFFECTS);
		bins = 10;
		bin_starts = min_effect + (0:(bins))*(max_effect - min_effect)/bins;
		
		i_vals = 0:(bins-1);
		counts = sapply(i_vals, "sum(EFFECTS >= bin_starts[applyValue] & EFFECTS < bin_starts[applyValue+1]);");
		x_vals = sapply(i_vals, "mean(bin_starts[c(applyValue, applyValue + 1)]);");
		
		plot = slimgui.createPlot("Mutation effects",
			xrange=c(min_effect - 1, max_effect + 1), yrange=c(0,max(counts) + 1),
			xlab="effect", ylab="count");
		
		plot.lines(x_vals, counts);
		plot.abline(v=0, color = 'black');
		
		// Phenotypes
		inds = sim.subpopulations.individuals;
		phenotypes = inds.getValue('phenotype');
		env_variables = executeLambda(QTL_ENV_VARIABLE + ";")[inds.subpopulation.id];
		plot = slimgui.createPlot("Phenotypes",
			xrange=c(min(env_variables), max(env_variables)), yrange=c(min(phenotypes), max(phenotypes)),
			xlab="environment", ylab="phenotype");
		plot.points(env_variables, phenotypes);
		
	}
}
function (void)updatePlotTPC(void)
{
	if (exists("slimgui"))
	{
		// Plot p0 through p4
	
		if(length(sim.subpopulations) <= 5) plot_subpops = sim.subpopulations[sim.subpopulations.individualCount != 0];
		if(length(sim.subpopulations) > 5) plot_subpops = sim.subpopulations[0:4][sim.subpopulations[0:4].individualCount != 0];
		
		Topt = sapply(plot_subpops, "mean(applyValue.individuals.getValue('Topt'));");
		epsilon = sapply(plot_subpops, "mean(applyValue.individuals.getValue('epsilon'));");
		temperature = seq(-30, 30, by = 0.1);
		plot = slimgui.createPlot("Thermal Performance Curve",
					xrange=c(min(temperature), max(temperature)), yrange=c(0, 1.0),
					xlab="temperature", ylab="performance");
		colors = colors(length(plot_subpops), 'cividis');
		for(i in seqAlong(epsilon)){
			P = thermal_performance(temperature, Topt[i], epsilon[i], asFloat(TOPT_COST), CONSTANT_AREA, asFloat(TOPT_BASELINE), asFloat(EPSILON_BASELINE));
			plot.lines(temperature, P, colors[i]);
		}
		
		// Mutational effects for Topt
		min_effect = min(TOPT_EFFECTS);
		max_effect = max(TOPT_EFFECTS);
		if(!isNULL(min_effect) & !isNULL(max_effect)){
			bins = 10;
			bin_starts = min_effect + (0:(bins))*(max_effect - min_effect)/bins;
			i_vals = 0:(bins-1);
			counts = sapply(i_vals, "sum(TOPT_EFFECTS >= bin_starts[applyValue] & TOPT_EFFECTS < bin_starts[applyValue+1]);");
			x_vals = sapply(i_vals, "mean(bin_starts[c(applyValue, applyValue + 1)]);");
			
			plot = slimgui.createPlot("Topt Mutation effects",
				xrange=c(min_effect - 1, max_effect + 1), yrange=c(0,max(counts) + 1),
				xlab="effect", ylab="count");
			
			plot.lines(x_vals, counts);
			plot.abline(v=0, color = 'black');
		}
		
		// Mutational effects for Epsilon
		
		min_effect = min(EPSILON_EFFECTS);
		max_effect = max(EPSILON_EFFECTS);
		if(!isNULL(min_effect) & !isNULL(max_effect)){
			bins = 10;
			bin_starts = min_effect + (0:(bins))*(max_effect - min_effect)/bins;
			i_vals = 0:(bins-1);
			counts = sapply(i_vals, "sum(EPSILON_EFFECTS >= bin_starts[applyValue] & EPSILON_EFFECTS < bin_starts[applyValue+1]);");
			x_vals = sapply(i_vals, "mean(bin_starts[c(applyValue, applyValue + 1)]);");
			
			plot = slimgui.createPlot("Epsilon Mutation effects",
				xrange=c(min_effect - 1, max_effect + 1), yrange=c(0,max(counts) + 1),
				xlab="effect", ylab="count");
			
			plot.lines(x_vals, counts);
			plot.abline(v=0, color = 'black');
		}
		
	}
}

initialize() {
	// Timing
	defineGlobal("start", clock());
	defineGlobal("tickstart", clock());
	
	// Default parameters
	// If the file ./params.json exists, PARAMFILE is specified, or parameters are specified on the command line
	// then the values of the default parameters will be overridden with the values sepcified
	defaults = Dictionary(
		//"SEED", getSeed(), // random seed
		"SEED", 5290, // random seed
		"RUNVARS_FILE", 'parameters2/slim_output/slim_parameters/run13/RunVars_slim.csv', // File containing run info
		"PARAM_FOLDER", './', // Folder containing parameter files
		"IND_OUT_FOLDER", "results_gui/", // Folder for individual output
		"ALLPOPS_OUT", "results_gui/summary_popAllTime.csv",
		"BYCLASS", "results_gui/summary_classAllTime.csv",
		"QTL_OUT", "results_gui/QTL_overall.csv",
		"QTL_SUBPOPS_OUT", "results_gui/QTL_subpops.csv",
		"MUTATION_OUTPUT_FILE", "results_gui/mutation_origins.csv",
		"MUTATION_EFFECTS_OUTPUT_FILE", "results_gui/mutation_effects.csv",
		"FINISHED", "results_gui/finished.txt",
		"SCALEPOPSIZE",1.0, // Decrease (or increase) carrying capacities for testing
		"NPATCHES", 'all', // Decrease number of patches for testing
		"TREESEQ", 'false',
		"TREESEQ_FILE", './trees'
	);
	
	// Set up parameters
	setupParams(defaults);
	defineGlobal("PARAMS", defaults);
	setSeed(SEED);
	print("Using seed " + getSeed());
	
	
	initializeSLiMModelType("nonWF");
	initializeSLiMOptions(keepPedigrees=T);
	initializeSex("A");
	if(TREESEQ == 'true') initializeTreeSeq();
	
	// Read in run vars file and get info
	defineConstant("RUNVARS", readCSV(RUNVARS_FILE));
	defineConstant("RUNTIME", asInteger(RUNVARS.getValue("runtime")[0]));
	defineConstant("SIZECONTROL", RUNVARS.getValue("sizecontrol") == "Y");
	print("sizecontrol " + SIZECONTROL);
	//Output ticks for all individuals
	output_split = asInteger(strsplit(asString(RUNVARS.getValue("output_years")), "|"));
	if(length(output_split) > 1){
		defineConstant("OUTPUT_TICKS", output_split);
	}
	if(length(output_split) == 1){
		defineConstant("OUTPUT_TICKS", rev(seq(RUNTIME, 1, by = -output_split)));
	}
	//Output ticks and focal subpopulations for origin of mutations
	// Both are optional: MUTATION_OUTPUT is T if mutation_output_years is given,
	// MUTATION_ORIGIN is T if mutation_origin_year is also given
	defineConstant("MUTATION_OUTPUT", !isNULL(RUNVARS.getValue('mutation_output_years')));
	defineConstant("MUTATION_ORIGIN", MUTATION_OUTPUT & !isNULL(RUNVARS.getValue('mutation_origin_year')));
	if(MUTATION_OUTPUT){
		output_split = asInteger(strsplit(asString(RUNVARS.getValue("mutation_output_years")), "|"));
		defineConstant("MUTATION_OUTPUT_TICKS", output_split);
		output_split = asInteger(strsplit(asString(RUNVARS.getValue("mutation_output_subpops")), "|"));
		if(NPATCHES == 'all') defineConstant("MUTATION_OUTPUT_SUBPOP_IDS", output_split);
		if(NPATCHES != 'all'){
			nfocal_subpops = min(NPATCHES, length(output_split));
			focal_subpops = sample(0:(NPATCHES-1), size = nfocal_subpops);
			defineConstant("MUTATION_OUTPUT_SUBPOP_IDS", focal_subpops);
		}
		if(MUTATION_ORIGIN) defineConstant('MUTATION_ORIGIN_TICK', asInteger(RUNVARS.getValue('mutation_origin_year'))[0]);
		writeMutationalOrigins(MUTATION_OUTPUT_FILE, T, MUTATION_OUTPUT_SUBPOP_IDS);
		writeMutationEffects(MUTATION_EFFECTS_OUTPUT_FILE, T);
	}
	// Placeholders so the MUTATION_OUTPUT_TICKS and MUTATION_ORIGIN_TICK blocks can be scheduled;
	// the blocks check MUTATION_OUTPUT / MUTATION_ORIGIN and do nothing when these are placeholders
	if(!MUTATION_OUTPUT) defineConstant("MUTATION_OUTPUT_TICKS", 1);
	if(!MUTATION_ORIGIN) defineConstant("MUTATION_ORIGIN_TICK", 1);
	// Read in popvars for every year
	defineConstant("POPVARS_ALL", readCSV(PARAM_FOLDER + RUNVARS.getValue("Popvars")[0]));
	// Is a QTL implemented, and is genome length specified or is a genome file specified?
	if(!isNULL(POPVARS_ALL.getValue("genome_length")) | !isNULL(POPVARS_ALL.getValue("genome"))) defineConstant("QTL", T); else defineConstant("QTL", F);
	if(!isNULL(POPVARS_ALL.getValue("genome"))) defineConstant("GENOME_FILE", T); else defineConstant("GENOME_FILE", F);
	// Is the thermal performance curve modeled?
	if(!isNULL(POPVARS_ALL.getValue("Topt_pheno_eff"))) defineConstant("QTL_TPC", T); else defineConstant("QTL_TPC", F);

	// Initialize with year 0
	defineGlobal("POPVARS", POPVARS_ALL.subsetRows(0));
	// Set up params that can't change
	setupConstantsFromPopVars(POPVARS);
	// Set up params that can change
	setupGlobalsFromPopVars(POPVARS);
	
	// What years does the climate change (if any)?
	if(POPVARS_ALL.nrow > 1){
		defineConstant("CHANGE_YEARS", POPVARS_ALL.getValue("year")[POPVARS_ALL.getValue("year")!=0]);
		defineConstant("CLIMATECHANGE", T);
		
	}
	else{
		// Placeholder
		defineConstant("CHANGE_YEARS", 1);
		defineConstant("CLIMATECHANGE", F);
	}
	
	// Output
	writeSubpopOutput(ALLPOPS_OUT, header = T);	
	writeClassOutput(BYCLASS, header = T);
	if(QTL){
		writeQTLOutputOverall(QTL_OUT, header = T, qtl_tpc = QTL_TPC);
		writeQTLOutputSubpops(QTL_SUBPOPS_OUT, header = T, qtl_tpc = QTL_TPC);
	}
	
	// Set up genome
	// Genomic element g1 is neutral loci set up like the original CDMetaPOP
	// Genomic element g2 is for quantitative trait
	// Both are optional
	if(GENOME_FILE & QTL & QTL_TPC){
		// Genome from file
		//Topt
		initializeMutationType("m2", 0.5, "s", TOPT_PHENO_EFF);
		// Neutral
		initializeMutationType("m3", 0.5, "f", 0.0);
		//Epsilon
		initializeMutationType("m4", 0.5, "s", EPSILON_PHENO_EFF);
		// Genomic element for QTL regions that control Topt and epsilon
		initializeGenomicElementType("g2", c(m2, m4), c(0.5, 0.5));
		// Genomic element for neutral regions
		initializeGenomicElementType("g3", m3, 1.0);
		// Read in genome: one row per linkage group (trout chromosome)
		genome = readCSV(PARAM_FOLDER + POPVARS.getValue('genome')[0]);
		// The linkage groups are laid end to end on a single SLiM chromosome, with a recombination rate of 0.5
		// between neighbouring groups so they are inherited independently, as separate chromosomes would be.
		// Inheritance is the same as with one SLiM chromosome per linkage group, but each individual has
		// 2 haplosomes instead of 2 per linkage group, which uses far less memory.
		n_lg = genome.nrow;
		lg_lengths = asInteger(genome.getValue('Length'));
		lg_offsets = c(0, cumSum(lg_lengths))[0:(n_lg - 1)]; // position of each linkage group's first base
		total_length = sum(lg_lengths);
		defineConstant('LINKAGE_GROUP_STARTS', lg_offsets);
		// Distribute QTL regions among linkage groups
		qtl_chroms = sample(0:(n_lg - 1), QTL_REGIONS, replace = T, weights = genome.getValue('Length')/sum(genome.getValue('Length')));
		// Number of qtls on each linkage group
		qtl_counts = tabulate(qtl_chroms, n_lg - 1);
		// Dictionary to store regions, mutation rates, and whether each region is a QTL or not (keyed by chromosome id)
		region_ends_dict = Dictionary();
		is_qtl_dict = Dictionary();
		mutation_rate_dict = Dictionary();
		// Mutation rate regions and recombination rate regions along the whole chromosome
		region_ends = c();
		mutation_rates = c();
		is_qtl = c();
		rec_ends = c();
		rec_rates = c();
		initializeChromosome(1, total_length, type = "A", symbol = "c1");
		for(i in 0:(n_lg - 1)){
			row = genome.subsetRows(i);
			id = row.getValue('Chromosome');
			offset = lg_offsets[i];
			length = lg_lengths[i];
			rr = row.getValue('recombination_rate');
			mr = row.getValue('mutation_rate');
			potential_nqtls = qtl_counts[i];
			print(potential_nqtls + " QTLs");
			// Pick start positions for QTL regions (relative to the start of the linkage group)
			// Number of non-overlapping QTL regions that fit on the linkage group (0 if it is shorter than one region)
			nslots = asInteger(floor(length/QTL_REGION_LENGTH));
			if(nslots > 0) potential_starts = (0:(nslots - 1))*QTL_REGION_LENGTH; else potential_starts = integer(0);
			nqtls = min(potential_nqtls, nslots);
			if(nqtls < potential_nqtls) print("Linkage group " + id + " only has room for " + nslots + " QTL regions; " + (potential_nqtls - nqtls) + " QTL regions dropped");
			if(nqtls > 0) qtl_starts = sort(sample(potential_starts, nqtls)); else qtl_starts = integer(0);
			// Add QTL genomic elements to QTL regions and neutral genomic elements to in between regions
			// (positions on the chromosome are the position in the linkage group + offset)
			neutral_start = 0;
			if(nqtls > 0) neutral_end = qtl_starts[0] - 1; else neutral_end = length - 1;
			// >= so that a 1 bp neutral region (start == end) is still added
			if(neutral_end >= neutral_start){
				initializeGenomicElement(g3, start = asInteger(offset + neutral_start), end = asInteger(offset + neutral_end));
				region_ends = c(region_ends, asInteger(offset + neutral_end));
				mutation_rates = c(mutation_rates, 0.0);
				is_qtl = c(is_qtl, F);
			}
			if(nqtls > 0){
				for(k in 0:(length(qtl_starts)-1)){
					start_pos = qtl_starts[k];
					neutral_start = start_pos + QTL_REGION_LENGTH;
					if (k < length(qtl_starts) - 1) neutral_end = qtl_starts[k + 1] - 1; else neutral_end = length - 1;
					initializeGenomicElement(g2, start = asInteger(offset + start_pos), end = asInteger(offset + start_pos + QTL_REGION_LENGTH - 1));
					region_ends = c(region_ends, asInteger(offset + start_pos + QTL_REGION_LENGTH - 1));
					mutation_rates = c(mutation_rates, mr);
					is_qtl = c(is_qtl, T);
					if(neutral_end >= neutral_start){
						initializeGenomicElement(g3, start = asInteger(offset + neutral_start), end = asInteger(offset + neutral_end));
						region_ends = c(region_ends, asInteger(offset + neutral_end));
						mutation_rates = c(mutation_rates, 0.0);
						is_qtl = c(is_qtl, F);
					}
				}
			}
			// Recombination: the linkage group's own rate within it, then 0.5 between its last base and the
			// next group's first base (the rate at position x applies between x and x + 1)
			last = offset + length - 1;
			if(i < n_lg - 1){
				if(length > 1){
					rec_ends = c(rec_ends, last - 1);
					rec_rates = c(rec_rates, rr*1e-8);
				}
				rec_ends = c(rec_ends, last);
				rec_rates = c(rec_rates, 0.5);
			}
			else{
				rec_ends = c(rec_ends, last);
				rec_rates = c(rec_rates, rr*1e-8);
			}
		}
		initializeMutationRate(mutation_rates*QTL_PROP_REGION, ends = region_ends);
		initializeRecombinationRate(rec_rates, ends = rec_ends);
		region_ends_dict.setValue(1, region_ends);
		is_qtl_dict.setValue(1, is_qtl);
		mutation_rate_dict.setValue(1, mutation_rates);
		m2.convertToSubstitution = T;
		m4.convertToSubstitution = T;
		defineConstant('GENOMIC_REGION_ENDS', region_ends_dict);
		defineConstant('GENOMIC_REGION_QTL', is_qtl_dict);
		defineConstant('GENOMIC_REGION_MUTATION_RATE', mutation_rate_dict);
	}
	if(GENOME_FILE & QTL & !QTL_TPC){
		// Genome from file
		initializeMutationType("m2", 0.5, "s", QTL_PHENO_EFF);
		initializeMutationType("m3", 0.5, "f", 0.0);
		initializeGenomicElementType("g2", c(m2, m3), c(QTL_PROP_GENOME, 1.0-QTL_PROP_GENOME));
		genome = readCSV(PARAM_FOLDER + POPVARS.getValue('genome')[0]);
		for(i in 0:(genome.nrow-1)){
			row = genome.subsetRows(i);
			id = row.getValue('Chromosome');
			length = row.getValue('Length');
			rr = row.getValue('recombination_rate');
			mr = row.getValue('mutation_rate');
			initializeChromosome(id, asInteger(length), type = "A", symbol = "c" + id);
			initializeMutationRate(mr);
			initializeRecombinationRate(rr*1e-8);
			initializeGenomicElement(g2);
		}
		m2.convertToSubstitution = T;
	}
	if(NLOCI == 0 & QTL & !GENOME_FILE & !QTL_TPC){
		// Mutation linked to quantitative trait
		initializeMutationType("m2", 0.5, "s", QTL_PHENO_EFF);
		// Neutral mutations
		initializeMutationType("m3", 0.5, "f", 0.0);
		initializeGenomicElementType("g2", c(m2, m3), c(QTL_PROP_GENOME, 1.0-QTL_PROP_GENOME));
		initializeGenomicElement(g2, 0, asInteger(QTL_GEN_LENGTH - 1));
		defineConstant("QTL_POSITIONS", 0:asInteger(QTL_GEN_LENGTH - 1));
		// Mutation rates and recombination rates
		initializeMutationRate(QTL_MUTERATE);
		initializeRecombinationRate(QTL_RECRATE);
		m2.convertToSubstitution = T;
	}
	if(NLOCI > 0 & QTL & !GENOME_FILE & !QTL_TPC){
		// Original CDMetaPOP loci
		initializeMutationType("m1", 0.5, "f", 0.0);
		initializeGenomicElementType("g1", m1, 1.0);
		initializeGenomicElement(g1, 0, NLOCI - 1);
		// Mutation linked to quantitative trait
		initializeMutationType("m2", 0.5, "s", QTL_PHENO_EFF);
		// Neutral mutations
		initializeMutationType("m3", 0.5, "f", 0.0);
		initializeGenomicElementType("g2", c(m2, m3), c(QTL_PROP_GENOME, 1.0 - QTL_PROP_GENOME));
		initializeGenomicElement(g2, NLOCI, asInteger(NLOCI - 1 + QTL_GEN_LENGTH));
		defineConstant("QTL_POSITIONS", NLOCI:asInteger(NLOCI - 1 + QTL_GEN_LENGTH));
		// Mutation rates and recombination rates
		initializeMutationRate(c(0, QTL_MUTERATE), c(NLOCI -1, asInteger(NLOCI + QTL_GEN_LENGTH - 1)));
		initializeRecombinationRate(c(0.5, QTL_RECRATE), c(NLOCI -1, asInteger(NLOCI + QTL_GEN_LENGTH - 1)));
		m1.convertToSubstitution = F;
		m2.convertToSubstitution = T;

	}
	if(NLOCI > 0 & !QTL & !GENOME_FILE & !QTL_TPC){
		initializeMutationType("m1", 0.5, "f", 0.0);
		initializeGenomicElementType("g1", m1, 1.0);
		initializeGenomicElement(g1, 0, NLOCI - 1);
		initializeMutationRate(c(0), c(NLOCI-1));
		initializeRecombinationRate(0.5);
		m1.convertToSubstitution = F;
	}

}

