// Helper functions
// Get age class of a vector of individuals
function (integer)age_class(object<Individual> individuals, string method){
	if(size(individuals) > 0){
		if(method == "age") return(pmin(individuals.getValue("cdmp_age"), max(CLASSVARS.getValue("Age class"))));
		if (method == "size"){
			sizes = individuals.getValue("size");
			return(size_class(sizes));
		}
	}
	else{
		return(c());
	}
}

// Age class with the closest mean body size (CLASSVARS "Body Size Mean (mm)") to each size; the first such class on ties
function (integer)size_class(float sizes){
	means = CLASSVARS.getValue("Body Size Mean (mm)");
	best = integer(length(sizes));
	best_distance = abs(sizes - means[0]);
	for (i in seqLen(length(means))){
		distance = abs(sizes - means[i]);
		closer = (distance < best_distance);
		best[closer] = i;
		best_distance[closer] = distance[closer];
	}
	return(CLASSVARS.getValue("Age class")[best]);
}

// Number of eggs produced by each individual
function (integer)num_eggs(object<Individual> inds){
	if(SIZECONTROL){
		if(POPVARS.getValue("Egg_Mean_ans") == "exp" & POPVARS.getValue("offno") == 2){
			E_mu = POPVARS.getValue("Egg_Mean_par1")*exp(POPVARS.getValue("Egg_Mean_par2")*inds.getValue("size"));
			return poisson_eggs(E_mu);
		}
		print("Egg_Mean_ans" + POPVARS.getValue("Egg_Mean_ans") + "offno" + POPVARS.getValue("offno") + " not supported yet. Using 2 offspring per individual.");
		return rep(2, size(inds));
	}
	age_i = match(age_class(inds, 'age'), CLASSVARS.getValue("Age class"));
	if(POPVARS.getValue("offno") == 2){
		return poisson_eggs(CLASSVARS.getValue("Fecundity Ind")[age_i]);
	}
	print("offno" + POPVARS.getValue("offno") + " not supported yet. Using 2 offspring per individual.");
	return rep(2, size(inds));
}

// Poisson number of eggs with mean E_mu (0 where E_mu <= 0)
function (integer)poisson_eggs(numeric E_mu){
	noffspring = integer(size(E_mu));
	positive = which(E_mu > 0);
	if(size(positive) > 0) noffspring[positive] = rpois(size(positive), E_mu[positive]);
	return noffspring;
}

// Destinations for straying individuals, following CDMetaPOP (GetProbArray 'strayer_emiPop' / 'strayer_natalPop'):
//   "emiPop": stray matrix row of the current patch
//   "natalPop": stray matrix row of the natal patch, only to patches reachable from the current patch
// STRAYMATRIX already excludes non-natal grounds; patches with K <= 0 are also excluded. -1 if there is nowhere to stray to.
function (integer)stray_destinations(object<Individual> individuals, string$ from){
	destinations = integer(length(individuals));
	open = asFloat(PATCHKS > 0);
	for (i in seqAlong(individuals)){
		current = individuals[i].subpopulation.id;
		if(from == "emiPop") weights = drop(STRAYMATRIX[current,]) * open;
		else{
			weights = drop(STRAYMATRIX[individuals[i].getValue("natal"),]) * open;
			weights[drop(STRAYMATRIX[current,]) == 0] = 0.0;
		}
		if(sum(weights) == 0) destinations[i] = -1;
		else destinations[i] = sample(PATCHIDS, size = 1, weights = weights);
	}
	return(destinations);
}

// Sample subpopulations according to a probability matrix
function (object<Subpopulation>)sample_subpops(object<Individual> individuals, float prob_matrix){
	sources = individuals.subpopulation;
	// Default destination is the current patch, so individuals with no possible destinations stay put
	destinations = sources.id;
	for (i in seqAlong(sources)){
		newpop_weights = prob_matrix[sources[i].id,];
		// If no patches to migrate to, stay in current patch
		if(sum(newpop_weights) == 0) next;
		new_destination = sample(PATCHIDS, size = 1, replace = T, weights = newpop_weights);
		destinations[i] = new_destination;
	}
	return(sim.subpopulations[destinations]);
}

// Caluclate the new size of an individual for temperature-dependent growth
function (float)grow_temperature(float current_size, integer age_class, float patch_temp, integer grow_days){
	X_max = asFloat(POPVARS.getValue("growth_temp_max"));
	X_CV = asFloat(POPVARS.getValue("growth_temp_CV"));
	R0 = asFloat(POPVARS.getValue("growth_R0"));
	Loo = asFloat(POPVARS.getValue("growth_Loo"));
	t0 = asFloat(POPVARS.getValue("growth_temp_t0"));
	
	int_R = -R0*dnorm(patch_temp, X_max, X_CV*X_max)/dnorm(X_max,  X_max, X_CV*X_max);
	L_inc = Loo * (1-exp(int_R*(age_class + 1-t0)))* dnorm(patch_temp, X_max, X_CV*X_max)/dnorm(X_max,  X_max, X_CV*X_max);
	L_inc_age = L_inc*exp((age_class+1)*(-R0));
	newsize = current_size + (L_inc_age * (grow_days/365));
	return(newsize);
}

// Grow
function (void)grow(string step){
	// all individuals except eggs
	all_ind = sim.subpopulations.individuals[sim.subpopulations.individuals.getValue('cdmp_age') != -1];
	patchids = all_ind.subpopulation.id;
	current_sizes = all_ind.getValue("size");
	age_classes = age_class(all_ind, method = "age");
	if (step == 'out'){
		patch_temperatures = GrowthTemperatureOut[patchids];
		grow_days = GrowDaysOut[patchids];
	}
	if (step == 'back'){
		patch_temperatures = GrowthTemperatureBack[patchids];
		grow_days = GrowDaysBack[patchids];
	}
	all_ind.setValuesVectorized("size", grow_temperature(current_sizes, age_classes, patch_temperatures, grow_days));
	return;
}

// Number of individuals in each of the given age classes (age_class() with the given method)
function (integer) count_age_classes(object<Individual> individuals, string$ method, integer classes){
	individual_classes = age_class(individuals, method);
	return sapply(classes, "sum(individual_classes == applyValue);");
}

// Set maturity (tagL0) of individuals. Individuals at or above the sex's age of maturity
// (mature_age_f, mature_age_m) mature; younger ones mature with a probability that depends on size (SIZECONTROL:
// logistic mature_eqn_int/mature_eqn_slope) or age (Maturation_F, Maturation_M in ClassVars).
// Calculated for all individuals at once.
function (void)mature(object <Individual> individuals){
	ages = age_class(individuals, 'age');
	females = (individuals.sex == "F");
	if (SIZECONTROL){
		sizes = individuals.getValue('size');
		intercept = ifelse(females, POPVARS.getValue("mature_eqn_int_f"), POPVARS.getValue("mature_eqn_int_m"));
		slope = ifelse(females, POPVARS.getValue("mature_eqn_slope_f"), POPVARS.getValue("mature_eqn_slope_m"));
		p_young = exp(intercept + slope*sizes) / (1 + exp(intercept + slope*sizes));
	}
	else{
		age_i = match(ages, CLASSVARS.getValue("Age class"));
		p_young = ifelse(females, asFloat(CLASSVARS.getValue("Maturation_F")[age_i]), asFloat(CLASSVARS.getValue("Maturation_M")[age_i]));
	}
	mature_age = ifelse(females, POPVARS.getValue("mature_age_f"), POPVARS.getValue("mature_age_m"));
	pmature = ifelse(ages >= mature_age, 1.0, p_young);
	individuals.tagL0 = runif(length(individuals)) < pmature;
	return;
}

// Thermal performance curve
// Area under the curve
function (float) area(float a, float b, float Topt, float epsilon){
  area = exp((a - Topt)/epsilon)*(a - 2*epsilon - Topt) + exp((b - Topt)/epsilon)*(-b + 2*epsilon + Topt);
  return(area);
}
function (float)thermal_performance(float temperature, float Topt, float epsilon, float Topt_cost, logical constant_area, float Topt_baseline, float epsilon_baseline){
	x = (temperature-Topt)/epsilon;
	// Area at epsilon_baseline and Topt_baseline
	ref_area = area(-50.0, Topt_baseline+epsilon_baseline, Topt_baseline, epsilon_baseline);
	// Area of current curve
	current_area = pmax(area(-50.0, Topt+epsilon, Topt, epsilon), ref_area);
//	print("---");
//	print(epsilon);
//	print(current_area);
//	print(ref_area);
	// Penalty to achieve reference area
	if(constant_area) area_penalty = ref_area/current_area; else area_penalty = 1.0;
	Topt_cost_scaling = pmax(0.0, pmin(1 - abs(Topt - Topt_baseline)*Topt_cost, 1.0));
   P = pmax(0.0, exp(x)*(1-x)*Topt_cost_scaling*area_penalty);
   // Independent environmental effect
   if(!isNULL(POPVARS.getValue('independent_environment_mean'))){
   	env_mean = asFloat(POPVARS.getValue('independent_environment_mean'));
   	env_sd = asFloat(POPVARS.getValue('independent_environment_sd'));
   	scaling = dnorm(temperature, mean = env_mean, sd = env_sd)/dnorm(env_mean, mean = env_mean, sd = env_sd);
   	P = P*scaling;
   }
   //print(P);
   return(P);
}

// Packing: number of survivors in each age class of a patch (age classes by age_class_method)
function (integer)packing_survivors(object<Subpopulation> pack_subpop, string age_class_method){
	ind_age_classes = age_class(pack_subpop.individuals, method = age_class_method); // Age classes of every individual in the population
	Nji = sapply(CLASSVARS.getValue("Age class"), "sum(ind_age_classes == applyValue);"); // Number of individuals in each age class
	return(packing_survivors_from_counts(Nji, PATCHKS[pack_subpop.id]));
}

// Packing: number of survivors in each age class, from the number of individuals in each age class (Nji, in the order
// of CLASSVARS "Age class") and the patch's carrying capacity Kj
function (integer)packing_survivors_from_counts(integer Nji, float$ Kj){
	is = CLASSVARS.getValue("Age class"); // Age classes and indices of age classes
	Nj = sum(Nji); // Current N
	if(Nj == 0 | Kj <= 0){
		return(integer(length(is)));
	}
	if (Kj == Nj) R0j = 1; else R0j = (log(Kj/Nj))/(1-Nj/Kj); // Adjusted R0
	R0ji = exp(R0j * (1-(Nji/Kj))); //class-specific, independent growth rate moment
	C = POPVARS.getValue("popmodel_par1"); // C
	Kji_unscaled = exp(C*(is+1));
	prop_Kji = Kji_unscaled/sum(Kji_unscaled); //ideal distribution of Kj among classes
	Kage_hab_adj = 0;
	Kage_hab_adj_inc = 0;
	// Loop through age classes oldest to youngest
	i_reversed = seq(max(is), min(is));
	nsurvive = float(length(is)); // Number of individuals that survive
	for (i in i_reversed){
		Kage_hab = prop_Kji[i];
		// Class count for redsitributing Khab
		classcount = sum(i_reversed <= i);
		Kage_hab_adj_inc = Kage_hab_adj_inc + (Kage_hab_adj/classcount);
		// Adjust the Kage_hab
		Kage_hab = Kage_hab + Kage_hab_adj_inc;
  		if (Nji[i] == 0) Kage = 0.0; else Kage = Nji[i]*exp(R0ji[i]*(1-(Nji[i]/(Kj*Kage_hab))));
  		Kused = min(asFloat(Nji[i]), Kage);
  		nsurvive[i] = Kused;
		if (Kage == 0) Kage_hab_adj = Kage_hab;
		else Kage_hab_adj = Kage_hab - (Kused * Kage_hab / Kage);
	}

	return(asInteger(round(nsurvive)));
}

// Density-dependent mortality out, decided before this tick's offspring are created.
// In each patch, the pool is the individuals in the patch plus the eggs laid there (NEGGS of the mothers with NATAL in
// the patch), which count as age class 0 (with SIZECONTROL, the size class of a body size drawn for each egg from age
// class 0). As in CDMetaPOP:
//   "packing": the number of survivors in each age class comes from packing_survivors(); survivors are a random
//              sample of the class.
//   "N":       if the pool is larger than K, a random sample of pool size - K dies.
// This gives the same distribution as creating every egg and then killing individuals at random within classes.
// Sets: tagL2 = T on individuals that die (killed in late()); OFFSPRING_SURVIVORS (surviving offspring of each mother,
// in the order of MOTHER_IDS); with SIZECONTROL, OFFSPRING_SIZES and OFFSPRING_SIZE_MOTHERS (body size and mother of
// each surviving offspring); N1, N1_AGE, DEATHS1 and DEATHS1_AGE (numbers before mortality and deaths, by patch and by
// age class, including offspring that are never created).
function (void)density_dependent_survival(void){
	model = POPVARS.getValue("popmodel");
	age_class_vals = CLASSVARS.getValue("Age class");
	n1 = integer(length(sim.subpopulations));
	n1_age = integer(length(age_class_vals));
	deaths = integer(length(sim.subpopulations));
	deaths_age = integer(length(age_class_vals));
	survivors = integer(length(NEGGS));
	surviving_sizes = float(0);
	surviving_size_mothers = integer(0);
	sim.subpopulations.individuals.tagL2 = F;
	for (subpop in sim.subpopulations){
		individuals = subpop.individuals;
		n_inds = length(individuals);
		// Eggs laid in the patch, as the index of their mother
		patch_mothers = which((NATAL == subpop.id) & (NEGGS > 0));
		egg_mothers = repEach(patch_mothers, NEGGS[patch_mothers]);
		n_eggs = length(egg_mothers);
		n_pool = n_inds + n_eggs;
		n1[subpop.id] = n_pool;
		if(n_pool == 0) next;
		// Age class (by size with SIZECONTROL) of each individual, then each egg
		if(SIZECONTROL){
			egg_sizes = rnorm(n_eggs, mean = CLASSVARS.getValue("Body Size Mean (mm)")[0], sd = CLASSVARS.getValue("Body Size Std (mm)")[0]);
			pool_classes = c(age_class(individuals, method = "size"), size_class(egg_sizes));
		}
		else pool_classes = c(age_class(individuals, method = "age"), rep(0, n_eggs));
		Nji = sapply(age_class_vals, "sum(pool_classes == applyValue);");
		n1_age = n1_age + Nji;
		survive = rep(T, n_pool);
		if(model == "packing"){
			nsurvivors = packing_survivors_from_counts(Nji, PATCHKS[subpop.id]);
			survive = rep(F, n_pool);
			for (i in seqAlong(age_class_vals)){
				in_class = which(pool_classes == age_class_vals[i]);
				if(nsurvivors[i] > 0) survive[sample(in_class, nsurvivors[i])] = T;
				ndie = Nji[i] - nsurvivors[i];
				deaths[subpop.id] = deaths[subpop.id] + ndie;
				deaths_age[i] = deaths_age[i] + ndie;
			}
		}
		if(model == "N"){
			nsurvivors = PATCHKS[subpop.id];
			if(n_pool > nsurvivors){
				ndeaths = asInteger(n_pool - nsurvivors);
				dead = sample(0:(n_pool - 1), ndeaths);
				survive[dead] = F;
				deaths[subpop.id] = ndeaths;
				// Deaths by age class (by age, also with SIZECONTROL); eggs are age 0
				death_ages = c(age_class(individuals, method = "age"), rep(0, n_eggs))[dead];
				deaths_age = deaths_age + sapply(age_class_vals, "sum(death_ages == applyValue);");
			}
		}
		if(n_inds > 0) individuals[!survive[0:(n_inds - 1)]].tagL2 = T;
		if(n_eggs > 0){
			egg_survives = survive[n_inds:(n_pool - 1)];
			surviving_mothers = egg_mothers[egg_survives];
			if(size(surviving_mothers) > 0) survivors = survivors + tabulate(surviving_mothers, length(NEGGS) - 1);
			if(SIZECONTROL){
				surviving_sizes = c(surviving_sizes, egg_sizes[egg_survives]);
				surviving_size_mothers = c(surviving_size_mothers, surviving_mothers);
			}
		}
	}
	defineGlobal("OFFSPRING_SURVIVORS", survivors);
	defineGlobal("OFFSPRING_SIZES", surviving_sizes);
	defineGlobal("OFFSPRING_SIZE_MOTHERS", surviving_size_mothers);
	defineGlobal("N1", n1);
	defineGlobal("N1_AGE", n1_age);
	defineGlobal("DEATHS1", deaths);
	defineGlobal("DEATHS1_AGE", deaths_age);
}

function (object <Dictionary>)packing(void){
	// Possible age classes
	age_class_vals = CLASSVARS.getValue("Age class");
	nkilled = integer(length(sim.subpopulations));
	nkilled_age = integer(length(age_class_vals));
	for (subpop in sim.subpopulations)
	{
		if(subpop.individualCount == 0) next;
		// Individuals and age classes
		individuals = subpop.individuals;
		if(SIZECONTROL) age_classes = age_class(individuals, method = "size"); else age_classes = age_class(individuals, method = "age");
		// Number of survivors of each age class
		if(SIZECONTROL) nsurvivors = packing_survivors(subpop, age_class_method = "size"); else nsurvivors = packing_survivors(subpop, age_class_method = "age");
		// Kill extra individuals in each age class
		for (i in seqAlong(age_class_vals)){
			age_class = age_class_vals[i];
			// Individuals in age class
			individual_subset = individuals[age_classes == age_class];
			ndie = length(individual_subset) - nsurvivors[age_class];
			sim.killIndividuals(sample(individual_subset, ndie));
			nkilled[subpop.id] = nkilled[subpop.id] + ndie;
			nkilled_age[i] = nkilled_age[i] + ndie;
		}
	}
	return(Dictionary("nkilled_subpops", nkilled, "nkilled_ages", nkilled_age));
}

function (object <Dictionary>)carrying_capacity_mortality(void){
	// Possible age classes
	age_class_vals = CLASSVARS.getValue("Age class");
	nkilled = integer(length(sim.subpopulations));
	nkilled_age = integer(length(age_class_vals));
	for (subpop in sim.subpopulations)
	{
		if(subpop.individualCount == 0) next;
		nsurvivors = PATCHKS[subpop.id];
		if(subpop.individualCount <= nsurvivors) next;
		ndeaths = asInteger(subpop.individualCount - nsurvivors);
		nkilled[subpop.id] = ndeaths;
		deaths = subpop.sampleIndividuals(ndeaths, replace = F);
		death_age_classes = age_class(deaths, 'age');
		sim.killIndividuals(deaths);
		for(i in seqAlong(age_class_vals)){
			nkilled_age[i] = nkilled_age[i] + sum(death_age_classes == age_class_vals[i]);
		}
	}
	return(Dictionary("nkilled_subpops", nkilled, "nkilled_ages", nkilled_age));
}


function (void)setupParams(object<Dictionary>$ defaults)
{
	if (!exists("PARAMFILE")) defineConstant("PARAMFILE", "./params.json");
	defaults.addKeysAndValuesFrom(Dictionary("PARAMFILE", PARAMFILE));
	
	if (fileExists(PARAMFILE)){
		defaults.addKeysAndValuesFrom(Dictionary(readFile(PARAMFILE)));
		defaults.setValue("READ_FROM_PARAMFILE", PARAMFILE);
	}
	
	for (k in defaults.allKeys) {
		if (!exists(k))
			defineConstant(k, defaults.getValue(k));
		else
			defaults.setValue(k, executeLambda(paste(c(k, ";"), sep='')));
	}
	
	// print out default values
	// catn("===========================");
	// catn("Model constants: " + defaults.serialize("pretty"));
	// catn("===========================");
}
function (void)setupConstantsFromPopVars(object<Dictionary>$ popvars)
{ 
	// Read in patch info and set up patch ids
	// If climate change is implemented, some variables in PatchVars can change over time
	// So, if climate change is implemented, set up using the the first year of PatchVars
	defineConstant("PATCHVARS_ALL", readCSV(PARAM_FOLDER + popvars.getValue("xyfilename")[0]));
	if(!isNULL(PATCHVARS_ALL.getValue("year"))) defineGlobal("PATCHVARS", PATCHVARS_ALL.subsetRows(PATCHVARS_ALL.getValue('year') == 1));
	else defineGlobal("PATCHVARS", PATCHVARS_ALL);
	
	patchids = (1:length(PATCHVARS.getValue("PatchID")))-1;
	patchks = PATCHVARS.getValue("K")*SCALEPOPSIZE;
	patchstdevs = PATCHVARS.getValue("K StDev")*SCALEPOPSIZE;
	patchn0s = PATCHVARS.getValue("N0")*SCALEPOPSIZE*PATCHVARS.getValue("Natal Grounds");
	// Files containing allele frequencies
	patch_genefiles = PATCHVARS.getValue("genes_file_slim");
	if(NPATCHES != "all"){
		if(!isInteger(NPATCHES) & !isFloat(NPATCHES)) stop("NPATCHES must be 'all' or a number of patches, but is '" + NPATCHES + "'.");
		if(NPATCHES < 1 | NPATCHES > length(patchids)) stop("NPATCHES is " + NPATCHES + ", but must be between 1 and the number of patches in PatchVars (" + length(patchids) + ").");
		defineConstant("PATCHIDS", patchids[0:(NPATCHES-1)]);
		defineGlobal("PATCHKS", rnorm(length(patchks[PATCHIDS]), patchks[PATCHIDS], patchstdevs[PATCHIDS]));
		defineConstant("PATCHN0S", patchn0s[PATCHIDS]);
		defineConstant("GENEFILES", patch_genefiles[PATCHIDS]);
	}
	if(NPATCHES == "all"){
		defineConstant("PATCHIDS", patchids);
		defineGlobal("PATCHKS", rnorm(length(patchks), patchks, patchstdevs));
		defineConstant("PATCHN0S", patchn0s);
		defineConstant("GENEFILES", patch_genefiles);
	}
	
	// Set up genes
	// What year to set up genes
	defineConstant("STARTGENES", popvars.getValue("startGenes"));
	// Get number of loci specified in POPVARS
	nloci_popvars = popvars.getValue("loci")[0];
	if(!isNULL(GENEFILES)){
		// Read in first gene file from PATCHVARS and record number of loci
		genes = readCSV(GENEFILES[0]);
		nloci_genefiles = max(genes.getValue("position")) + 1;
		// Check agreement
		if (nloci_popvars != nloci_genefiles){
			print("Disagreement between number of loci in gene files provided in PATCHVARS and number of loci specified in popvars, using number specified in gene files");
		}
		defineConstant("NLOCI", nloci_genefiles);
	}
	else{
		defineConstant("NLOCI", nloci_popvars);
		defineConstant("NALLELES", popvars.getValue("alleles")[0]);
	}
	//print(NLOCI);
	
	if(QTL & !QTL_TPC){
		// Set up QTL
		defineConstant("QTL_GEN_LENGTH", popvars.getValue('genome_length'));
		defineConstant("QTL_PROP_GENOME", popvars.getValue('qtl_prop_genome'));
		defineConstant("QTL_PHENO_EFF", popvars.getValue('qtl_pheno_eff') + ";");
		defineConstant("QTL_ENV_VARIABLE", popvars.getValue('qtl_env_variable'));
		defineConstant("QTL_BASELINE", mean(PATCHVARS.getValue(QTL_ENV_VARIABLE)));
	}
	if(QTL_TPC){
		defineConstant('QTL_REGIONS', popvars.getValue('qtl_regions'));
		defineConstant('QTL_REGION_LENGTH', popvars.getValue('qtl_region_length'));
		defineConstant("TOPT_BASELINE", popvars.getValue('Topt_baseline'));
		defineConstant("EPSILON_BASELINE", popvars.getValue('epsilon_baseline'));
		defineConstant("TOPT_VE", popvars.getValue('Topt_VE'));
		defineConstant("EPSILON_VE", popvars.getValue('epsilon_VE'));
		defineConstant("TOPT_COST", popvars.getValue('Topt_cost'));
		defineConstant("CONSTANT_AREA", popvars.getValue('constant_area'));
		defineConstant("TOPT_PHENO_EFF", popvars.getValue('Topt_pheno_eff') + ";");
		defineConstant("EPSILON_PHENO_EFF", popvars.getValue('epsilon_pheno_eff') + ";");
	}
}

function (void)setupGlobalsFromPopVars(object<Dictionary>$ popvars){
	
	// Classvars
	defineGlobal("CLASSVARS",readCSV(PARAM_FOLDER + PATCHVARS.getValue("classvars")[0]));
	
	// Mating system and matrix
	if(popvars.getValue('matemoveno') == '6'){
		defineGlobal("MATING", "within_patch");
	}
	if(popvars.getValue('matemoveno') == '9'){
		defineGlobal("MATING", "matrix");
		mate_matrix = readCSV(PARAM_FOLDER + popvars.getValue('mate_cdmat'), colNames = asString(PATCHIDS), colTypes = paste0(rep('f', length(PATCHIDS))));
		if (NPATCHES != "all"){mate_matrix = mate_matrix.subsetColumns(PATCHIDS).subsetRows(PATCHIDS);}
		// Convert to float (idk why this is so involved! There must be a better way.)
		for (i in PATCHIDS){
			old_vals = mate_matrix.getValue(asString(i));
			new_vals = float(length(old_vals));
			for(j in seqAlong(new_vals)){new_vals[j] = asFloat(old_vals[j]);}
			mate_matrix.setValue(asString(i), new_vals); 
		}
		defineGlobal("MATEMATRIX", mate_matrix.asMatrix());
	}
	
	// Don't allow individuals to go to non-natal grounds in the back step
	
	// Migration out matrix
	migration_matrix = readCSV(PARAM_FOLDER + popvars.getValue('migrateout_cdmat'), colNames = asString(PATCHIDS), colTypes = paste0(rep('f', length(PATCHIDS)))).asMatrix();
	mgrounds = PATCHVARS.getValue("Migration Grounds");
	migration_matrix[,mgrounds == 0] = 0; // Can't migrate to non-migration grounds
	if (NPATCHES != "all"){migration_matrix = migration_matrix[PATCHIDS,PATCHIDS];}
	defineGlobal("MIGRATIONOUT", asFloat(migration_matrix));
	
	// Straying matrix
	stray_matrix = readCSV(PARAM_FOLDER + popvars.getValue('stray_cdmat'), colNames = asString(PATCHIDS), colTypes = paste0(rep('f', length(PATCHIDS)))).asMatrix();
	ngrounds = PATCHVARS.getValue("Natal Grounds");
	stray_matrix[,ngrounds == 0] = 0; // Can't stray to non-natal grounds
	if (NPATCHES != "all"){stray_matrix = stray_matrix[PATCHIDS,PATCHIDS];}
	defineGlobal("STRAYMATRIX", asFloat(stray_matrix));
	
	// What happens to migrants that fail to return to their natal patch (CDMetaPOP HomeAttempt)
	if(isNULL(popvars.getValue("HomeAttempt"))) homeattempt = "mortality"; else homeattempt = asString(popvars.getValue("HomeAttempt")[0]);
	if(!any(homeattempt == c("mortality", "stray_emiPop", "stray_natalPop"))) stop("HomeAttempt must be mortality, stray_emiPop, or stray_natalPop, but is '" + homeattempt + "'.");
	defineGlobal("HOMEATTEMPT", homeattempt);
	
	// Migration back matrix (only used for the probability of returning to the natal patch, below)
	back_matrix = asFloat(readCSV(PARAM_FOLDER + popvars.getValue('migrateback_cdmat'), colNames = asString(PATCHIDS), colTypes = paste0(rep('f', length(PATCHIDS)))).asMatrix());
	
	// Probability of returning to the natal patch from the emigrated patch
	// Matches CDMetaPOP (GetProbArray, 'immigrator'), using the migrate back matrix as read from file:
	//   BA = Back[emigrated, natal] (getting home), AB = Back[natal, emigrated] (getting out)
	//   BA < AB: partial barrier, probability 1 - (AB - BA)/AB = BA/AB (BA = 0 gives 0: complete barrier)
	//   otherwise: probability 1. As in CDMetaPOP, this includes BA = AB = 0.
	//   Natal patch must be a natal ground. (Natal patches with K = 0 are handled at migration time.)
	// Rows are the emigrated patch, columns the natal patch
	BA = back_matrix;
	AB = t(back_matrix);
	return_matrix = matrix(rep(1.0, length(BA)), nrow = nrow(BA));
	partial = BA < AB;
	return_matrix[partial] = BA[partial] / AB[partial];
	return_matrix[, ngrounds == 0] = 0.0;
	if (NPATCHES != "all"){return_matrix = return_matrix[PATCHIDS,PATCHIDS];}
	defineGlobal("RETURNMATRIX", return_matrix);
	
	// Dispersal matrix
	dispersal_matrix = readCSV(PARAM_FOLDER + popvars.getValue('disperse_cdmat'), colNames = asString(PATCHIDS), colTypes = paste0(rep('f', length(PATCHIDS))));
	if (NPATCHES != "all"){dispersal_matrix = dispersal_matrix.subsetColumns(PATCHIDS).subsetRows(PATCHIDS);}
	defineGlobal("DISPERSELOCAL", asFloat(dispersal_matrix.asMatrix()));
	
	// Mutation rate
	defineGlobal("MUTRATE", popvars.getValue("muterate"));
	
	// QTL parameters
	defineGlobal("QTL_MUTERATE", popvars.getValue("qtl_muterate"));
	defineGlobal("QTL_RECRATE", popvars.getValue("qtl_recrate"));
	defineGlobal("QTL_VE", popvars.getValue("qtl_ve"));
	defineGlobal("QTL_FIT_SD", popvars.getValue("qtl_fit_sd"));
	if(QTL_TPC){
		defineGlobal('QTL_PROP_REGION', popvars.getValue('qtl_prop_region'));
	}

}

// Expected heterozygosity at the microsatellite loci, as in CDMetaPOP (GetMetrics): 1 - (sum of squared allele frequencies)/loci.
// Each allele at each locus is an m1 mutation, and every haplosome carries one allele per locus. (calcHeterozygosity()
// would give 2*sum(p(1 - p)) per chromosome position: twice this for loci where every allele is a mutation, divided by the
// whole chromosome length rather than the number of loci.)
function (float$) msatHe(object<Subpopulation> subpops){
	p = sim.mutationFrequencies(subpops, sim.mutationsOfType(m1));
	return 1.0 - sum(p^2)/NLOCI;
}

function (void)writeSubpopOutput(string outfile, logical header){
	if(header){
		writeFile(outfile, "Year,K,GrowthRate,N_Initial,PopSizes_Mean,PopSizes_Std,N_Females,N_Males,N_MatureFemales,N_MatureMales,MatureCount,ImmatureCount,EggLayEvents,Births,EggDeaths,N_beforePacking_AddAge0s,PackingDeaths_Emigration,PackingDeaths_Immigration,N_Emigration,Alleles,He,Ho");
		return;
	}
	year = community.tick;
	K = paste(c(sum(PATCHKS),PATCHKS), sep = "|");
	GrowthRate = sum(sim.subpopulations.individualCount)/sum(N_INITIAL);
	N_Initial = paste(c(sum(N_INITIAL), N_INITIAL), sep = "|");
	PopSizes_Mean = mean(N_INITIAL);
	PopSizes_Std = sd(N_INITIAL);
	N_Females = paste(c(sum(SUBPOP_NFEMALES), SUBPOP_NFEMALES), sep = "|");
	N_Males = paste(c(sum(SUBPOP_NMALES), SUBPOP_NMALES), sep = "|");
	N_MatureFemales = paste(c(sum(SUBPOP_NMATUREFEMALES), SUBPOP_NMATUREFEMALES), sep = "|");
	N_MatureMales = paste(c(sum(SUBPOP_NMATUREMALES), SUBPOP_NMATUREMALES), sep = "|");
	MatureCount = sum(c(SUBPOP_NMATUREFEMALES, SUBPOP_NMATUREMALES));
	ImmatureCount = sum(c(SUBPOP_NFEMALES - SUBPOP_NMATUREFEMALES, SUBPOP_NMALES - SUBPOP_NMATUREMALES));
	EggLayEvents = EGGLAYEVENTS;
	Births = paste(c(sum(BIRTHS), BIRTHS), sep = "|");
	EggDeaths = paste(c(sum(EGGDEATHS), EGGDEATHS), sep = "|");
	N_beforePacking_AddAge0s = paste(c(sum(N1), N1), sep = "|");
	PackingDeaths_Emigration = paste(c(sum(DEATHS1), DEATHS1), sep = "|");
	PackingDeaths_Immigration = paste(c(sum(DEATHS2), DEATHS2), sep = "|");
	N_Emigration = paste(c(sum(N2), N2), sep = "|");
	// helper variables
	if(NLOCI > 0){
		nalleles_total = length(unique(sim.subpopulations.individuals.haplosomes.mutationsOfType(m1)));
		nalleles = sapply(sim.subpopulations, "length(unique(applyValue.individuals.haplosomes.mutationsOfType(m1)));");
		He_total = msatHe(sim.subpopulations);
		Ho_total = mean(sapply(sim.subpopulations.individuals, "calcPairHeterozygosity(applyValue.haplosomes[0], applyValue.haplosomes[1], start = 0, end = NLOCI - 1, infiniteSites=F);"));
		He_subpops = float(length(sim.subpopulations));
		Ho_subpops = float(length(sim.subpopulations));
		for (subpop in sim.subpopulations){
			if (subpop.individualCount > 0){
				He_subpops[subpop.id] = msatHe(subpop);
				Ho_subpops[subpop.id] = mean(sapply(subpop.individuals, "calcPairHeterozygosity(applyValue.haplosomes[0], applyValue.haplosomes[1], start = 0, end = NLOCI - 1, infiniteSites=F);"));
			}
			else{
				He_subpops[subpop.id] = -1;	
				Ho_subpops[subpop.id] = -1;
			}
		}
	}
	if(NLOCI == 0){
		nalleles_total = -1;
		nalleles = sapply(sim.subpopulations, "-1;");
		He_total = -1;
		Ho_total = -1;
		He_subpops = sapply(sim.subpopulations, "-1;");
		Ho_subpops = sapply(sim.subpopulations, "-1;");
	}
	// end helper variables
	Alleles = paste(c(nalleles_total, nalleles), sep = "|");
	He = paste(c(He_total, He_subpops), sep = "|");
	Ho = paste(c(Ho_total, Ho_subpops), sep = "|");
	
	writeFile(outfile, paste(c(year,K,GrowthRate, N_Initial, PopSizes_Mean, PopSizes_Std, N_Females, N_Males, N_MatureFemales, N_MatureMales, MatureCount, ImmatureCount, EggLayEvents, Births, EggDeaths, N_beforePacking_AddAge0s, PackingDeaths_Emigration, PackingDeaths_Immigration, N_Emigration, Alleles, He, Ho), sep = ","), append = T);
		
}

// Narrow-sense heritability Va/Vp from genetic values g and phenotypes p (NAN if fewer than 2 individuals or no phenotypic variance)
function (float$) h2_from_values(float g, float p){
	if(size(p) < 2) return NAN;
	vp = var(p);
	if(vp == 0) return NAN;
	return var(g)/vp;
}

// Narrow-sense heritability Va/Vp of a trait among inds: overall first, then one value per patch (sim.subpopulations order).
// Va is the variance of the summed effects of mut_type, as in calcVA(). Genetic values, phenotypes and patches are looked up
// once and then subset for each patch.
function (float) heritability_overall_and_by_patch(object<Individual> inds, string$ trait, object<MutationType>$ mut_type){
	if(size(inds) == 0) return rep(NAN, 1 + length(sim.subpopulations));
	g = inds.sumOfMutationsOfType(mut_type);
	p = asFloat(inds.getValue(trait));
	patch = inds.subpopulation.id;
	h2 = h2_from_values(g, p);
	for (sp in sim.subpopulations){
		in_patch = (patch == sp.id);
		h2 = c(h2, h2_from_values(g[in_patch], p[in_patch]));
	}
	return h2;
}

// Heritability value for output: 'NA' if it could not be calculated
function (*) heritability_output(float$ h2){
	if(isNAN(h2)) return 'NA';
	return h2;
}

// Mean for output: 'NA' if there are no values. (mean() of an empty vector is NULL, which would
// leave the value out of the output line and shift the columns after it.)
function (*) mean_or_NA(numeric x){
	if(size(x) == 0) return 'NA';
	return mean(x);
}

// Nucleotide diversity (pi) of the individuals in subpops, averaged over the autosomes, for mutations of the given types.
// Same calculation as calcPi() (SLiM) for each chromosome, counting each segregating mutation once:
//   pi = sum over mutations of k(n - k) / (n(n - 1)/2) / chromosome length
// where k is the number of the n haplosomes (2 per individual) that carry the mutation.
// Done for all chromosomes at once because calcPi() is slow (about 3 ms per call, even with no mutations).
function (float$) meanPi(object<Subpopulation> subpops, object<MutationType> mut_types){
	chromosomes = sim.chromosomesOfType("A");
	n = 2*sum(subpops.individualCount);
	muts = sim.mutations;
	muts = muts[(match(muts.mutationType.id, mut_types.id) >= 0) & (muts.chromosome.type == "A")];
	if(size(muts) == 0) return 0.0;
	k = sim.mutationCounts(subpops, muts);
	return sum(k*(n - k) / (n*(n - 1)/2) / muts.chromosome.length) / length(chromosomes);
}

function (void) writeQTLOutputOverall(string outfile, logical header, logical qtl_tpc){
	if(!qtl_tpc) overall_header = "year,K,popsize,phenotypic_variance,Va,Ve,heritability,qtl_alleles,avg_effect_size,neutral_pi,overall_pi";
	if(qtl_tpc) overall_header = "year,K,popsize,Topt_variance,Topt_Va,Topt_Ve,Topt_heritability,Topt_alleles,Topt_avg_effect_size,epsilon_variance,epsilon_Va,epsilon_Ve,epsilon_heritability,epsilon_alleles,epsilon_avg_effect_size,neutral_pi,overall_pi";
	if(header){
		writeFile(outfile, overall_header);
		return;
	}
	year = community.tick;
	K = sum(PATCHKS);
	popsize = sum(sim.subpopulations.individualCount);
	if(popsize > 1 & !qtl_tpc){
		phenotypic_variance = var(sim.subpopulations.individuals.getValue('phenotype'));
		Va = calcVA(sim.subpopulations.individuals, m2);
		Ve = var(sim.subpopulations.individuals.getValue('phenotype') - sim.subpopulations.individuals.sumOfMutationsOfType(m2));
		// Heritability is calculated from this tick's newborns, before selection (see early())
		heritability = heritability_output(H2_OVERALL);
		qtl_alleles = length(unique(sim.subpopulations.individuals.haplosomes.mutationsOfType(m2)));
		avg_effect_size = mean_or_NA(abs(c(sim.subpopulations.individuals.haplosomes.mutationsOfType(m2).selectionCoeff, sim.substitutionsOfType(m2).selectionCoeff)));
		neutral_pi = meanPi(sim.subpopulations, m3);
		overall_pi = meanPi(sim.subpopulations, c(m3, m2));
		print("QTL alleles: " + qtl_alleles);
	}
	if(popsize > 1 & qtl_tpc){
		Topt_variance = var(sim.subpopulations.individuals.getValue('Topt'));
		Topt_Va = calcVA(sim.subpopulations.individuals, m2);
		Topt_Ve = var(sim.subpopulations.individuals.getValue('Topt') - sim.subpopulations.individuals.sumOfMutationsOfType(m2));
		// Heritability is calculated from this tick's newborns, before selection (see early())
		Topt_heritability = heritability_output(H2_TOPT_OVERALL);
		Topt_alleles = length(unique(sim.subpopulations.individuals.haplosomes.mutationsOfType(m2)));
		Topt_avg_effect_size = mean_or_NA(abs(c(sim.subpopulations.individuals.haplosomes.mutationsOfType(m2).selectionCoeff, sim.substitutionsOfType(m2).selectionCoeff)));
		epsilon_variance = var(sim.subpopulations.individuals.getValue('epsilon'));
		epsilon_Va = calcVA(sim.subpopulations.individuals, m4);
		epsilon_Ve = var(sim.subpopulations.individuals.getValue('epsilon') - sim.subpopulations.individuals.sumOfMutationsOfType(m4));
		epsilon_heritability = heritability_output(H2_EPSILON_OVERALL);
		epsilon_alleles = length(unique(sim.subpopulations.individuals.haplosomes.mutationsOfType(m4)));
		epsilon_avg_effect_size = mean_or_NA(abs(c(sim.subpopulations.individuals.haplosomes.mutationsOfType(m4).selectionCoeff, sim.substitutionsOfType(m4).selectionCoeff)));
		neutral_pi = meanPi(sim.subpopulations, m3);
		overall_pi = meanPi(sim.subpopulations, c(m3, m2, m4));
	}
	if(popsize <= 1){
		phenotypic_variance = 'NA';
		Va = 'NA';
		Ve = 'NA';
		heritability = 'NA';
		qtl_alleles = 'NA';
		neutral_pi = 'NA';
		overall_pi = 'NA';
		avg_effect_size = 'NA';
		Topt_variance = 'NA';
		Topt_Va = 'NA';
		Topt_Ve = 'NA';
		Topt_heritability = 'NA';
		Topt_alleles = 'NA';
		Topt_avg_effect_size = 'NA';
		epsilon_variance = 'NA';
		epsilon_Va = 'NA';
		epsilon_Ve = 'NA';
		epsilon_heritability = 'NA';
		epsilon_alleles = 'NA';
		epsilon_avg_effect_size = 'NA';
	}
	overall_line = paste(executeLambda("c(" + overall_header + ");"), sep = ",");
	writeFile(outfile, overall_line, append = T);
	return;
}
