// Mating and eggs: each mature female mates with one mature male and lays eggs.
// MATING "within_patch": the mate is a random mature male from her patch. "matrix": the mate's patch is drawn from the
// female's row of MATEMATRIX among patches with mature males, then the mate is a random mature male from that patch.
// Females without a possible mate don't reproduce.
// Only the number of eggs of each female is decided here (MOTHER_IDS, FATHER_IDS, NATAL, NEGGS); offspring that survive
// density-dependent mortality are created in reproduction().
first(){
	print("Mating");
	defineGlobal("MOTHER_IDS", integer(0));
	defineGlobal("FATHER_IDS", integer(0));
	defineGlobal("NATAL", integer(0));
	defineGlobal("NEGGS", integer(0));
	inds = sim.subpopulations.individuals;
	females = inds[(inds.sex == "F") & inds.tagL0];
	males = inds[(inds.sex == "M") & inds.tagL0];
	if(size(females) == 0 | size(males) == 0) return;
	female_patch = females.subpopulation.id;
	male_patch = males.subpopulation.id;
	// Patch of each female's mate (-1: no mate)
	mate_patch = rep(-1, size(females));
	if(MATING == "within_patch"){
		mate_patch = ifelse(match(female_patch, male_patch) >= 0, female_patch, -1);
	}
	if(MATING == "matrix"){
		male_patches = unique(male_patch);
		for (p in unique(female_patch)){
			in_p = which(female_patch == p);
			weights = c(MATEMATRIX[p, male_patches]);
			if(sum(weights) > 0) mate_patch[in_p] = sample(male_patches, size(in_p), replace = T, weights = weights);
		}
	}
	// Mate of each female (index into males): a random mature male from the mate patch
	mate_i = rep(-1, size(females));
	for (p in unique(mate_patch[mate_patch >= 0])){
		mating = which(mate_patch == p);
		mate_i[mating] = sample(which(male_patch == p), size(mating), replace = T);
	}
	has_mate = (mate_i >= 0);
	females = females[has_mate];
	female_patch = female_patch[has_mate];
	mates = males[mate_i[has_mate]];
	if(size(females) == 0) return;
	defineGlobal("EGGLAYEVENTS", EGGLAYEVENTS + size(females));
	females.tagL1 = T; // Lay eggs?
	// Number of eggs before egg mortality (the thermal performance curve scales fecundity)
	pre_mort_neggs = num_eggs(females);
	if(QTL_TPC){
		tpc_scale = thermal_performance(GrowthTemperatureBack[female_patch], females.getValue('Topt'), females.getValue('epsilon'), asFloat(TOPT_COST), CONSTANT_AREA, asFloat(TOPT_BASELINE), asFloat(EPSILON_BASELINE));
		pre_mort_neggs = asInteger(round(pre_mort_neggs*tpc_scale));
	}
	// Number of surviving eggs including egg mortality
	//neggs = rbinom(1, size = pre_mort_neggs, prob = 1- PATCHVARS.getValue("Mortality Eggs")[subpop.id]);
	neggs = asInteger(round(pre_mort_neggs*(1- PATCHVARS.getValue("Mortality Eggs")[female_patch])));
	new_births = BIRTHS;
	new_eggdeaths = EGGDEATHS;
	for (p in unique(female_patch)){
		in_p = (female_patch == p);
		new_births[p] = BIRTHS[p] + sum(pre_mort_neggs[in_p]);
		new_eggdeaths[p] = EGGDEATHS[p] + sum(pre_mort_neggs[in_p] - neggs[in_p]);
	}
	defineGlobal("BIRTHS", new_births);
	defineGlobal("EGGDEATHS", new_eggdeaths);
	// Offspring are created in reproduction(), after density-dependent mortality has been decided
	defineGlobal("MOTHER_IDS", females.pedigreeID);
	defineGlobal("FATHER_IDS", mates.pedigreeID);
	defineGlobal("NATAL", female_patch);
	defineGlobal("NEGGS", neggs);
}

// Growth for "Back" and aging. Done before offspring are created (newborns are created at age 0, see reproduction()).
first(){
	if (SIZECONTROL){
		// Growth for "Back"
		print("Growing Back");
		grow('back');
	}
	// Aging
	print("Aging");
	individuals = sim.subpopulations.individuals;
	individuals.setValuesVectorized("cdmp_age", individuals.getValue("cdmp_age") + 1);
	if(!SIZECONTROL){
		// Set new body sizes based on age (but don't let individuals shrink)
		ages = age_class(individuals, method = "age");
		potential_new_sizes =  rnorm(length(individuals), mean = CLASSVARS.getValue("Body Size Mean (mm)")[ages], sd = CLASSVARS.getValue("Body Size Std (mm)")[ages]);
		individuals.setValuesVectorized('size', pmax(individuals.getValue('size'), potential_new_sizes));
	}

	ages = CLASSVARS.getValue("Age class")[CLASSVARS.getValue("Age class") != 0];
	if(SIZECONTROL) defineGlobal("N_GROWTHBACK", c(0, count_age_classes(sim.subpopulations.individuals, 'size', ages))); else defineGlobal("N_GROWTHBACK", c(0, count_age_classes(sim.subpopulations.individuals, 'age', ages)));
}
first(){
	print("Migration Out");
	// Migration out. Runs before this tick's offspring are created, so they don't migrate out: as in CDMetaPOP, where
	// offspring are added after the migrate-out step, individuals first migrate out the year after they are born, at age 1.
	individuals = sim.subpopulations.individuals;
	if(SIZECONTROL) age_classes = age_class(individuals, method = "size"); else age_classes = age_class(individuals, method = "age");
	pmigrate_out = PATCHVARS.getValue("Migration Out Prob")[individuals.subpopulation.id]*CLASSVARS.getValue("Migration Out Prob")[age_classes];
	migrators = individuals[runif(length(individuals)) < pmigrate_out];
	destinations = sample_subpops(migrators, MIGRATIONOUT);
	//print(sum(destinations.id == 3) + " individuals migrated to 3.");
	for (dest in unique(destinations)){dest.takeMigrants(migrators[destinations == dest]);}
	// Individuals that had somewhere to migrate to are now migrants (see Straying and Migration Back)
	if(length(migrators) > 0){
		had_destination = sapply(migrators.subpopulation.id, "sum(MIGRATIONOUT[applyValue,]) > 0;");
		migrators[had_destination].setValue("migrant", T);
	}
	//popsizes = sapply(sim.subpopulations, "applyValue.individualCount;");
	//print("Population sizes: " + paste(popsizes));
}

// Density-dependent mortality out ("packing" or "N"), decided before offspring are created so that only surviving
// offspring are created (see density_dependent_survival()). Individuals that die are killed in late().
first(){
	if(POPVARS.getValue("popmodel") == "packing") print("Packing out (deciding survivors)");
	if(POPVARS.getValue("popmodel") == "N") print("Density dependent out (deciding survivors)");
	density_dependent_survival();
}

// Reproduction, once per tick for all patches: create the offspring that survive density-dependent mortality
// (OFFSPRING_SURVIVORS, from density_dependent_survival()), in the mother's patch at mating (NATAL).
// Offspring are created at age 0 and, as newborns in CDMetaPOP, get a body size drawn from age class 0 (with
// SIZECONTROL, the size drawn in density_dependent_survival()) and, without SIZECONTROL, a maturity.
reproduction(NULL, "F") {
	// SLiM calls this callback for each female; all offspring are created in the first call, so turn it off for the rest of the tick
	self.active = 0;
	creating = which(OFFSPRING_SURVIVORS > 0);
	if(size(creating) == 0) return;
	inds = sim.subpopulations.individuals;
	ids = inds.pedigreeID;
	mothers = inds[match(MOTHER_IDS[creating], ids)];
	fathers = inds[match(FATHER_IDS[creating], ids)];
	natal_patches = sim.subpopulations[match(NATAL[creating], sim.subpopulations.id)];
	counts = OFFSPRING_SURVIVORS[creating];
	// Effects of fixed QTL mutations (homozygous)
	if(QTL) fixed_m2 = 2*sum(sim.substitutionsOfType(m2).selectionCoeff);
	if(QTL & QTL_TPC) fixed_m4 = 2*sum(sim.substitutionsOfType(m4).selectionCoeff);
	// Without microsatellite mutation the mutation callback (s1) does nothing, so don't call it for every offspring this tick
	if(MUTRATE * NLOCI == 0) s1.active = 0;
	// Created and given traits one mother at a time: this is faster than calculating traits for all offspring at once
	for (i in seqAlong(creating)){
		offspring = natal_patches[i].addCrossed(mothers[i], fathers[i], count = counts[i]);
		offspring.setValue("natal", NATAL[creating[i]]);
		offspring.setValue("migrant", F);
		offspring.setValue("cdmp_age", 0);
		offspring.tagL0 = F;
		offspring.tagL1 = F;
		offspring.tagL2 = F;
		if(SIZECONTROL){
			offspring.setValuesVectorized("size", OFFSPRING_SIZES[OFFSPRING_SIZE_MOTHERS == creating[i]]);
		}
		else{
			offspring.setValuesVectorized("size", rnorm(counts[i], mean = CLASSVARS.getValue("Body Size Mean (mm)")[0], sd = CLASSVARS.getValue("Body Size Std (mm)")[0]));
			// Mature age 0s if SIZECONTROL is not operating
			// Note that this behavior is for consistency with CDMetaPOP, and could be a bug in CDMetaPOP
			mature(offspring);
		}
		// QTL
		if(QTL & !QTL_TPC){
			phenotypes = offspring.sumOfMutationsOfType(m2) + fixed_m2 + rnorm(length(offspring), mean = 0, sd = sqrt(QTL_VE)) + QTL_BASELINE;
			offspring.setValuesVectorized("phenotype", phenotypes);
		}
		if(QTL & QTL_TPC){
			Topts = offspring.sumOfMutationsOfType(m2) + fixed_m2 + rnorm(length(offspring), mean = 0, sd = sqrt(TOPT_VE)) + TOPT_BASELINE;
			epsilons = offspring.sumOfMutationsOfType(m4) + fixed_m4 + rnorm(length(offspring), mean = 0, sd = sqrt(EPSILON_VE)) + EPSILON_BASELINE;
			offspring.setValuesVectorized("Topt", Topts);
			offspring.setValuesVectorized("epsilon", pmax(0.001, epsilons));
		}
	}
}

// Mutation (applies to offspring in every patch). Turned off in reproduction() when there is no microsatellite mutation.
s1 modifyChild() {
	// Nothing to do without microsatellite mutation (this callback runs for every offspring)
	if(MUTRATE * NLOCI == 0) return T;
	for (genome in child.haplosomes){
		if(MUTRATE * NLOCI > 0) mutCount = rpois(1, MUTRATE * NLOCI);
		else mutCount = 0;
		if (mutCount){
			//print("Mutation count!");
			mutSites = sample(0:(NLOCI-1), mutCount);
			ind_mutations = genome.mutationsOfType(m1);
			for (mutSite in mutSites){
				ind_mut = ind_mutations[ind_mutations.position == mutSite];
				current_allele = ind_mut.tag;
				// Select a new allele from all possible alleles at that site
				potential_alleles = ALLELES_PER_LOCUS_VALS.getValue(mutSite);
				new_allele = sample(potential_alleles[potential_alleles != current_allele], 1);
				//print("New mutation: old allele " + current_allele + " new allele " + new_allele);
				// Add to genome
				all_mutations = sim.mutationsOfType(m1);
				mutsAtSite = all_mutations[all_mutations.position == mutSite];
				matchingMut = mutsAtSite[mutsAtSite.tag == new_allele];
				// If there is a mutation with the same allele already in the genome,
				// don't make a new mutation
				if (matchingMut.size() == 1){
					genome.removeMutations(ind_mut);
					genome.addMutations(matchingMut);
				}
				else{
					// if not, make a new mutation with the new repeat count
					genome.removeMutations(ind_mut);
					new_mut = genome.addNewDrawnMutation(m1, mutSite);
					new_mut.tag = new_allele;
				}
				//new_site = genome.mutationsOfType(m1)[genome.mutationsOfType(m1).position == mutSite];
				//print("Post mutation at site " + " allele " + new_site.tag);
			}
		}
	}
	return T;
}


early(){
	// Heritability of the quantitative trait (or of Topt and epsilon), calculated from this tick's newborns
	// (age 0 after aging) before any selection or mortality, so that genetic and environmental effects are independent.
	// Written in the QTL output later this tick.
	if(QTL){
		inds = sim.subpopulations.individuals;
		newborns = inds[inds.getValue("cdmp_age") == 0];
		if(!QTL_TPC){
			h2 = heritability_overall_and_by_patch(newborns, "phenotype", m2);
		defineGlobal("H2_OVERALL", h2[0]);
			defineGlobal("H2_SUBPOPS", h2[1:(length(h2) - 1)]);
		}
		else{
			h2_topt = heritability_overall_and_by_patch(newborns, "Topt", m2);
			h2_epsilon = heritability_overall_and_by_patch(newborns, "epsilon", m4);
			defineGlobal("H2_TOPT_OVERALL", h2_topt[0]);
			defineGlobal("H2_EPSILON_OVERALL", h2_epsilon[0]);
			defineGlobal("H2_TOPT_SUBPOPS", h2_topt[1:(length(h2_topt) - 1)]);
			defineGlobal("H2_EPSILON_SUBPOPS", h2_epsilon[1:(length(h2_epsilon) - 1)]);
		}
	}
}

mutationEffect(m1) { return 1.0; }
mutationEffect(m2) { return 1.0; }
mutationEffect(m3) { return 1.0; }
mutationEffect(m4) { return 1.0; }



late(){
	// Density dependent mortality: kill the individuals chosen in density_dependent_survival() (before offspring were
	// created). N1, N1_AGE, DEATHS1 and DEATHS1_AGE, which include offspring that were never created, are set there too.
	if(POPVARS.getValue("popmodel") == "packing") print("Packing out");
	if(POPVARS.getValue("popmodel") == "N") print("Density dependent out");
	sim.killIndividuals(sim.subpopulations.individuals[sim.subpopulations.individuals.tagL2]);
	print(sum(DEATHS1) + " individuals killed.");
	if(sum(sim.subpopulations.individualCount) == 0){
		if(TREESEQ == 'true') sim.treeSeqOutput(TREESEQ_FILE, overwriteDirectory=T);
		writeFile(FINISHED, "Simulation extinct");
		stop("Extinct in " + (clock() - start) + " seconds.");
	}

}

late(){
	// Age-dependent mortality out
	print("Age-dependent mortality out");
	individuals = sim.subpopulations.individuals;
	age_classes = age_class(individuals, method = "age");
	prob_dies = CLASSVARS.getValue("Age Mortality Out %")[age_classes];
	kill = individuals[runif(length(individuals)) < prob_dies];
	sim.killIndividuals(kill);
	print(length(kill) + " individuals died.");
	if(sum(sim.subpopulations.individualCount) == 0){
		if(TREESEQ == 'true') sim.treeSeqOutput(TREESEQ_FILE, overwriteDirectory=T);
		writeFile(FINISHED, "Simulation extinct");
		stop("Extinct in " + (clock() - start) + " seconds.");
	}

}

