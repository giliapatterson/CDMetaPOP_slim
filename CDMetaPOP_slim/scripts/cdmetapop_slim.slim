late(){
	// Maturing
	print("Maturing");
	// Find individuals that aren't yet mature
	individuals = sim.subpopulations.subsetIndividuals(tagL0 = F);
	//print(length(individuals) + " individuals aren't yet mature.");
	if(length(individuals)>0){
		mature(individuals);
		print(sum(individuals.tagL0) + " individuals matured.");
	}
	else{
		print("No non-mature individuals");
	}
	// CDMetaPOP output here


}

late(){
	print("Straying and Migration Back");
	// Follows CDMetaPOP (Immigration). Only migrants (individuals that migrated out and have not yet returned
	// home or strayed) are considered:
	//   1. Decide whether to migrate back (Migration Back Prob of the current patch and of the class).
	//      Migrants that don't migrate back stay where they are and remain migrants.
	//   2. Of those migrating back, decide whether to stray (Straying Prob of the natal patch and of the class).
	//      Strayers move using the stray matrix row of their current patch (patches with K > 0 only), and that
	//      patch becomes their natal patch. If there is nowhere to stray to, they die.
	//   3. The rest attempt to return to their natal patch (RETURNMATRIX; not possible if the natal patch has K = 0).
	//      Those that fail die or stray again according to HOMEATTEMPT.
	all_inds = sim.subpopulations.individuals;
	individuals = all_inds[all_inds.getValue("migrant")];
	n = length(individuals);
	if(n == 0) return;
	if(SIZECONTROL) age_classes = age_class(individuals, method = "size"); else age_classes = age_class(individuals, method = "age");
	natal_pops = individuals.getValue("natal");
	emigrated_pops = individuals.subpopulation.id;
	
	// 1. Migrate back?
	pmigrate_back = PATCHVARS.getValue("Migration Back Prob")[emigrated_pops]*CLASSVARS.getValue("Migration Back Prob")[age_classes];
	goes_back = runif(n) < pmigrate_back;
	// 2. Stray?
	pstray = PATCHVARS.getValue("Straying Prob")[natal_pops]*CLASSVARS.getValue("Straying Prob")[age_classes];
	does_stray = goes_back & (runif(n) < pstray);
	// 3. Make it home?
	preturn = sapply(seqAlong(individuals), "RETURNMATRIX[emigrated_pops[applyValue], natal_pops[applyValue]];") * asFloat(PATCHKS[natal_pops] > 0);
	attempts = goes_back & !does_stray;
	returns = attempts & (runif(n) < preturn);
	fails = attempts & !returns;
	
	// Destinations (-1 = dies)
	destinations = rep(-1, n);
	destinations[returns] = natal_pops[returns];
	if(sum(does_stray) > 0) destinations[does_stray] = stray_destinations(individuals[does_stray], "emiPop");
	if(sum(fails) > 0){
		if(HOMEATTEMPT == "stray_emiPop") destinations[fails] = stray_destinations(individuals[fails], "emiPop");
		if(HOMEATTEMPT == "stray_natalPop") destinations[fails] = stray_destinations(individuals[fails], "natalPop");
		// HOMEATTEMPT == "mortality": destinations stay -1
	}
	moves = goes_back & destinations >= 0;
	strayed = moves & !returns;
	
	// Strayers get a new natal patch; individuals that return home or stray are no longer migrants
	if(sum(strayed) > 0) individuals[strayed].setValuesVectorized("natal", destinations[strayed]);
	if(sum(moves) > 0){
		individuals[moves].setValue("migrant", F);
		for (dest in unique(destinations[moves])){sim.subpopulations[dest].takeMigrants(individuals[moves & destinations == dest]);}
	}
	dies = goes_back & destinations < 0;
	if(sum(dies) > 0) sim.killIndividuals(individuals[dies]);
	print(n + " migrants: " + sum(returns) + " returned home, " + sum(strayed) + " strayed, " + sum(dies) + " died trying to return or stray, " + sum(!goes_back) + " stayed.");
}

