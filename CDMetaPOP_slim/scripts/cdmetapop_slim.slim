function (void)writeIndOutput(string outfile, logical header){
	if (header){
		if(NLOCI > 0){
			loci_names = sapply(0:(NLOCI-1), "paste0('L', applyValue);");
			haplosome1_names = sapply(loci_names, "paste0(applyValue, 'A0');");
			haplosome2_names = sapply(loci_names, "paste0(applyValue, 'A1');");
			if(!QTL){
				header_string = paste0("PatchID,XCOORD,YCOORD,ID,sex,age,size,mature,layeggs,", paste(c(haplosome1_names, haplosome2_names), sep = ","));
			}
			if(QTL){
				header_string = paste0("PatchID,XCOORD,YCOORD,ID,sex,age,size,mature,layeggs,", paste(c(haplosome1_names, haplosome2_names), sep = ","), ",phenotype");
			}
		}
		if(NLOCI == 0 & !QTL){
			header_string = "PatchID,XCOORD,YCOORD,ID,sex,age,size,mature,layeggs";
		}
		if(NLOCI == 0 & QTL){
			header_string = "PatchID,XCOORD,YCOORD,ID,sex,age,size,mature,layeggs,phenotype";
		}
		writeFile(outfile, header_string);
		return;
	}
	non_extinct_subpops = sim.subpopulations[sim.subpopulations.individualCount !=0];
	for (subpop in non_extinct_subpops){
		PatchID = subpop.id;
		XCOORD = PATCHVARS.getValue('X')[PatchID];
		YCOORD = PATCHVARS.getValue('Y')[PatchID];
		for (ind in subpop.subsetIndividuals(minAge = 1)){
			ID = ind.pedigreeID;
			sex = ind.sex;
			age = ind.getValue("cdmp_age");
			size = ind.getValue("size");
			mature = asInteger(ind.tagL0);
			layeggs = asInteger(ind.tagL1);
			if(NLOCI > 0){
				if(!QTL){
					writeFile(outfile, paste(c(PatchID,XCOORD,YCOORD,ID,sex,age,size,mature,layeggs,ind.haplosomes[0].mutationsOfType(m1).tag,ind.haplosomes[1].mutationsOfType(m1).tag), sep = ","), append = T);
				}
				if(QTL){
					writeFile(outfile, paste(c(PatchID,XCOORD,YCOORD,ID,sex,age,size,mature,layeggs,ind.haplosomes[0].mutationsOfType(m1).tag,ind.haplosomes[1].mutationsOfType(m1).tag,ind.getValue('phenotype')), sep = ","), append = T);
				}
			}
			if(NLOCI == 0 & !QTL){
				writeFile(outfile, paste(c(PatchID,XCOORD,YCOORD,ID,sex,age,size,mature,layeggs), sep = ","), append = T);
			}
			if(NLOCI == 0 & QTL){
				writeFile(outfile, paste(c(PatchID,XCOORD,YCOORD,ID,sex,age,size,mature,layeggs,ind.getValue('phenotype')), sep = ","), append = T);
			}
		}	
	}
}