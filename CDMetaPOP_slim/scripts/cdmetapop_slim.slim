1 first() {
	print("Setting up patches");
	// Set up patches
	for (patchID in PATCHIDS){
		new_subpop = sim.addSubpop(patchID, asInteger(PATCHN0S[patchID]));
		if (new_subpop.individualCount > 0){
			individuals = new_subpop.individuals;
			individuals.setValue("natal", patchID);
			individuals.setValue("migrant", F); // T after migrating out, until returning home or straying
			cdmp_ages = sample(CLASSVARS.getValue("Age class"), size = new_subpop.individualCount, replace = T, weights = CLASSVARS.getValue("Distribution"));
			// Keep track of age separately so that it can be updated in the correct order
			individuals.setValuesVectorized("cdmp_age", cdmp_ages);
			// Initial sizes
			individuals.setValuesVectorized("size", rnorm(new_subpop.individualCount, mean = CLASSVARS.getValue("Body Size Mean (mm)")[cdmp_ages], sd = CLASSVARS.getValue("Body Size Std (mm)")[cdmp_ages]));
			// Set maturity
			mature(individuals);
			individuals.tagL1 = F; // Lay eggs
			// Set phenotypes by patch
			if(QTL & !isNULL(PATCHVARS.getValue('qtl_loci_initial')) & !GENOME_FILE){
				genomes = new_subpop.haplosomes;
				loci = sample(QTL_POSITIONS, PATCHVARS.getValue('qtl_loci_initial')[new_subpop.id]);
				pheno_effects = executeLambda(PATCHVARS.getValue('qtl_dpe_initial')[new_subpop.id] + ";");
				//print(pheno_effects);
				new_mutations = genomes.addNewMutation(m2, pheno_effects, loci); 
			}
		}	
	}
	// Set initial mutations and phenotypes for trait
	if(QTL){
		if(!isNULL(POPVARS.getValue('qtl_mutations_initial')) & !GENOME_FILE){
			nmutations = asInteger(POPVARS.getValue('qtl_mutations_initial'));
			if(nmutations > 0){
				mut_haplosomes = sample(sim.subpopulations.individuals.haplosomes, nmutations, replace = T);
				mut_positions = sample(QTL_POSITIONS, nmutations, replace = T);
				for(i in 0:(length(mut_haplosomes) - 1)){
					if(!QTL_TPC) mut_haplosomes[i].addNewDrawnMutation(m2, mut_positions[i]);
					if(QTL_TPC) mut_haplosomes[i].addNewDrawnMutation(sample(c(m2, m4), 1), mut_positions[i]);
				}
			}
		}
		if(!isNULL(POPVARS.getValue('qtl_mutations_initial')) & GENOME_FILE & !QTL_TPC){
			nmutations = asInteger(POPVARS.getValue('qtl_mutations_initial'));
			if(nmutations > 0){
				mut_chroms = sample(sim.chromosomes, nmutations, replace = T, weights = sim.chromosomes.length/sum(sim.chromosomes.length));
				for(chrom in mut_chroms){
					locus = sample(0:chrom.lastPosition, 1);
					mut_hap = sample(sim.subpopulations.haplosomesForChromosomes(chrom), 1);
					mut_hap.addNewDrawnMutation(m2, locus);
				}
			}
		}
		if(!isNULL(POPVARS.getValue('qtl_mutations_initial')) & GENOME_FILE & QTL_TPC){
			nmutations = asInteger(POPVARS.getValue('qtl_mutations_initial'));
			print("nmutations " + nmutations + " per QTL region");
			if(nmutations > 0){
				for(chrom in sim.chromosomes){
					QTL_ends = GENOMIC_REGION_ENDS.getValue(chrom.id)[GENOMIC_REGION_QTL.getValue(chrom.id)];
					QTL_starts = QTL_ends - QTL_REGION_LENGTH + 1;
					if(length(QTL_ends) > 0){
						for(qtl_i in 0:(length(QTL_starts) - 1)){
							loci = asInteger(sample(QTL_starts[qtl_i]:QTL_ends[qtl_i], nmutations));
							// Sample with replacement only if there are more mutations than haplosomes (e.g. small test populations)
							haps = sim.subpopulations.haplosomesForChromosomes(chrom);
							mut_hap = sample(haps, nmutations, replace = (nmutations > length(haps)));
							for(mut_i in 0:(length(mut_hap) - 1)) mut_hap[mut_i].addNewDrawnMutation(sample(c(m2, m4), 1), loci[mut_i]);
						}
					}
				}
			}
		}
		individuals = sim.subpopulations.individuals;
		if(!QTL_TPC){
			phenotypes = individuals.sumOfMutationsOfType(m2) + 2*sum(sim.substitutionsOfType(m2).selectionCoeff) + rnorm(length(individuals), mean = 0, sd = sqrt(QTL_VE)) + QTL_BASELINE;
			individuals.setValuesVectorized("phenotype", phenotypes);
		}
		if(QTL_TPC){
			Topts = individuals.sumOfMutationsOfType(m2) + 2*sum(sim.substitutionsOfType(m2).selectionCoeff) + rnorm(length(individuals), mean = 0, sd = sqrt(TOPT_VE)) + TOPT_BASELINE;
			epsilons = individuals.sumOfMutationsOfType(m4) + 2*sum(sim.substitutionsOfType(m4).selectionCoeff) + rnorm(length(individuals), mean = 0, sd = sqrt(EPSILON_VE)) + 	EPSILON_BASELINE;
			individuals.setValuesVectorized("Topt", Topts);
			individuals.setValuesVectorized("epsilon", pmax(0.001, epsilons));
		}
	}
}

STARTGENES first(){
	if(NLOCI > 0){
		print("Setting up genes");
		if(!isNULL(GENEFILES)){
			// Set up genes in patches
			for (patch in sim.subpopulations){
				// Add genes
				gene_freqs = readCSV(GENEFILES[patch.id]);
				positions = 0:(NLOCI-1);
				// All genomes in the patch
				genomes = patch.haplosomes;
				ngenomes = length(genomes);
				// Loop through all loci
				all_loci = unique(gene_freqs.getValue('position'));
				// Keep track of number of alleles for each locus
				alleles_per_locus = integer(length(all_loci));
				// Keep track of alleles for each locus
				alleles_per_locus_vals = Dictionary();
				for (locus_index in seqAlong(all_loci)){
					locus = all_loci[locus_index];
					// Get alleles for the locus
					locus_df = gene_freqs.subsetRows(gene_freqs.getValue('position') == locus);
					freqs = locus_df.getValue('Frequency');
					alleles = locus_df.getValue('allele');
					alleles_per_locus[locus_index] = length(alleles);
					// Keyed by position, because modifyChild() looks alleles up by mutation position
					alleles_per_locus_vals.setValue(locus, alleles);
					// Select alleles for each genome
					genome_alleles = sample(alleles, ngenomes, replace = T, weights = freqs);
					// assign alleles counts to genomes
					for (allele_val in alleles){
						// Find genomes with each count
						genome_subset = genomes[genome_alleles == allele_val];
						if(genome_subset.size()){
							// Is this a new mutation?
							all_alleles = sim.mutationsOfType(m1);
							allelesAtSite = all_alleles[all_alleles.position == locus];
							matchingMut = allelesAtSite[allelesAtSite.tag == allele_val];
							// If not, add old mutation
							if (matchingMut.size() == 1){
								genome_subset.addMutations(matchingMut);
							}
							// If yes, create new mutation
							else{
								mut = genome_subset.addNewDrawnMutation(m1, locus);
								mut.tag = allele_val;
							}
						}
					}
				}
			}
		}
		else{
			// Add alleles randomly
			positions = 0:(NLOCI-1);
			alleles = 0:(NALLELES - 1);
			// All genomes
			genomes = sim.subpopulations.haplosomes;
			ngenomes = length(genomes);
			// Record number of alleles for each locus
			alleles_per_locus = integer(length(positions), fill1 = length(alleles));
			// Keep track of alleles for each locus
			alleles_per_locus_vals = Dictionary();
			for (locus in positions){
				alleles_per_locus_vals.setValue(locus, alleles);
				// Get alleles for the locus
				// Select alleles for each genome
				genome_alleles = sample(alleles, ngenomes, replace = T);
				// assign alleles counts to genomes
				for (allele_val in alleles){
					// Find genomes with each count
					genome_subset = genomes[genome_alleles == allele_val];
					if(genome_subset.size()){
						// Is this a new mutation?
						all_alleles = sim.mutationsOfType(m1);
						allelesAtSite = all_alleles[all_alleles.position == locus];
						matchingMut = allelesAtSite[allelesAtSite.tag == allele_val];
						// If not, add old mutation
						if (matchingMut.size() == 1){
							genome_subset.addMutations(matchingMut);
						}
						// If yes, create new mutation
						else{
							mut = genome_subset.addNewDrawnMutation(m1, locus);
							mut.tag = allele_val;
						}
					}
				}
			}
		}
		defineConstant("ALLELES_PER_LOCUS", alleles_per_locus);
		defineConstant("ALLELES_PER_LOCUS_VALS", alleles_per_locus_vals);
	}	
}

