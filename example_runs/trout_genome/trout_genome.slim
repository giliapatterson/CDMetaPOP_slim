// Keywords: multiple chromosomes
function (void)updatePlot(void)
{
	if (exists("slimgui"))
	{
		
		// Phenotypes
		inds = sim.subpopulations.individuals;
		Topt = mean(inds.getValue('Topt'));
		epsilon = mean(inds.getValue('epsilon'));
		temperature = seq(-30, 30, by = 0.1);
		x = (temperature-Topt)/epsilon;
      P = pmax(0.0, exp(x)*(1-x) - epsilon*0.01);
		plot = slimgui.createPlot("Thermal Performance Curve",
			xrange=c(min(temperature), max(temperature)), yrange=c(0, 1.0),
			xlab="temperature", ylab="performance");
		plot.lines(temperature, P);
		
	}
}

initialize() {
	initializeSLiMModelType("nonWF");
	initializeSex();
	// Genome from file
	//Topt
	initializeMutationType("m2", 0.5, "s", 'sample(c(-1, 1), 1)*rexp(1, mu = 0.1);');
	initializeMutationType("m3", 0.5, "f", 0.0);
	//CTmax
	initializeMutationType("m4", 0.5, "s", 'sample(c(-1, 1), 1)*rexp(1, mu = 0.1);');
	defineConstant('QTL_PROP_GENOME', 0.8);
	initializeGenomicElementType("g2", c(m2, m3, m4), c(QTL_PROP_GENOME/2, 1.0-QTL_PROP_GENOME, QTL_PROP_GENOME/2));
	genome = readCSV('trout_genome.csv');
	for(i in 0:(genome.nrow-1)){
		row = genome.subsetRows(i);
		id = row.getValue('Chromosome');
		length = row.getValue('Length');
		rr = row.getValue('recombination_rate');
		mr = row.getValue('mutation_rate');
		initializeChromosome(id, asInteger(length), type = "A", symbol = "c" + id);
		initializeMutationRate(mr);
		initializeRecombinationRate(rr*1e-8);
		initializeGenomicElement(g2);
	}
	m2.convertToSubstitution = T;
	m4.convertToSubstitution = T;
}
1 first() {
	sim.addSubpop("p1", 1000); 
	individuals = sim.subpopulations.individuals;
	Topts = individuals.sumOfMutationsOfType(m2) + sum(sim.substitutionsOfType(m2).selectionCoeff) + rnorm(length(individuals), mean = 0, sd = 1) + 10;
	individuals.setValuesVectorized("Topt", Topts);
	epsilons = abs(individuals.sumOfMutationsOfType(m4) + sum(sim.substitutionsOfType(m4).selectionCoeff) + rnorm(length(individuals), mean = 0, sd = 1) + 0);
	individuals.setValuesVectorized("epsilon", epsilons);
	defineGlobal('MEAN_TEMP', 10);
	temperature = rnorm(1, MEAN_TEMP, 0.1);
	defineGlobal('TEMPERATURE', temperature);
}
reproduction(NULL, "F") {
	potential_mates = subpop.subsetIndividuals(sex = "M");
	if(exists("potential_mates")){
		if(length(potential_mates) > 0){
			mate = sample(potential_mates, 1);
