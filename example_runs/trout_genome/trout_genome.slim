			//tpc_scaling = max(0.0, thermal_performance(TEMPERATURE, individual.getValue('Topt'), 2.0));
			//noffspring = asInteger(round(tpc_scaling*5));
			noffspring = 20;
			offspring = subpop.addCrossed(individual, mate, count = noffspring);
		}
	}
}

modifyChild(){
	child.setValue('Topt', child.sumOfMutationsOfType(m2) + sum(sim.substitutionsOfType(m2).selectionCoeff) + rnorm(1, mean = 0, sd = 1) + 10);
	child.setValue('epsilon', abs(child.sumOfMutationsOfType(m4) + sum(sim.substitutionsOfType(m4).selectionCoeff) + rnorm(1, mean = 0, sd = 1) + 0));
	return(T);
}

800:850 early(){
	defineGlobal('MEAN_TEMP', MEAN_TEMP + 10/50);
}
early(){
	p1.fitnessScaling = min(1000/p1.individualCount, 1.5);
	temperature = rnorm(1, MEAN_TEMP, 0.1);
	defineGlobal('TEMPERATURE', temperature);
	individuals = sim.subpopulations.individuals;
	individuals[individuals.age == 4].fitnessScaling = 0.0;
	tpc = thermal_performance(temperature, individuals.getValue('Topt'), individuals.getValue('epsilon'));
	// Penalty for high epsilon
	cost = individuals.getValue('epsilon')*0.01;
	individuals.fitnessScaling = pmax(tpc - cost, 0.0);
}
mutationEffect(m1) { return 1.0; }
mutationEffect(m2) { return 1.0; }
mutationEffect(m3) { return 1.0; }
mutationEffect(m4) { return 1.0; }

late(){
	print("Tick: " + community.tick);
	print("Temp: " + TEMPERATURE);
	print("Topt: " + mean(p1.individuals.getValue('Topt')));
	print("epsilon: " + mean(p1.individuals.getValue('epsilon')));
	updatePlot();
}

1000 early() { sim.simulationFinished(); }

function (float)thermal_performance(float temperature, float Topt, float epsilon){
	x = (temperature-Topt)/epsilon;
   P = pmax(0.0, exp(x)*(1-x));
   return(P);
}
